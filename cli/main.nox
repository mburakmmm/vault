# VAULT — Command Line Interface (Powered by NOX 2.1 nox.argparse)
# Module: cli.main

from core.builder import ConfigBuilder
from core.snapshot import ConfigSnapshot
from core.errors import ConfigError
from profiles.overlay import is_valid_profile_name
from schema.fields import ConfigSchema
from nox.os import OsError
from nox.argparse import ArgumentParser, Namespace, ArgumentError
import nox.os
import nox.strings

CLI_VERSION: str = "1.1.0"

def _build_parser() -> ArgumentParser:
    root: ArgumentParser = ArgumentParser(
        "vault",
        "VAULT — Secure Configuration & Secret Management CLI"
    )
    root.add_flag("-v", "--version", "Print vault library version")

    # Subcommand: validate
    p_val: ArgumentParser = ArgumentParser("vault validate", "Validate configuration against schema, format, and optional Ed25519 signature")
    p_val.add_option("", "--config", "", "Path to config file (.json, .toml, .yaml, .env)", False)
    p_val.add_option("", "--profile", "development", "Configuration profile (default: development)", False)
    p_val.add_option("", "--root", ".", "Allowed root directory for file confinement", False)
    p_val.add_option("", "--verify-ed25519", "", "Hex Ed25519 publisher public key (64 chars)", False)
    p_val.add_option("", "--sig", "", "Hex Ed25519 signature for --config file (128 chars)", False)
    root.add_command("validate", p_val, "Validate configuration against schema and format")

    # Subcommand: explain
    p_exp: ArgumentParser = ArgumentParser("vault explain", "Explain configuration key provenance without secret leakage")
    p_exp.add_positional("key", "Configuration key to explain provenance for")
    p_exp.add_option("", "--config", "", "Path to config file (.json, .toml, .yaml)", False)
    p_exp.add_option("", "--profile", "development", "Configuration profile (default: development)", False)
    p_exp.add_option("", "--root", ".", "Allowed root directory for file confinement", False)
    root.add_command("explain", p_exp, "Explain configuration key provenance without secret leakage")

    # Subcommand: check-env
    p_env: ArgumentParser = ArgumentParser("vault check-env", "Check process environment against required keys")
    p_env.add_option("", "--keys", "", "Comma-separated required keys for check-env", True)
    root.add_command("check-env", p_env, "Check process environment against required keys")

    # Subcommand: fingerprint
    p_fp: ArgumentParser = ArgumentParser("vault fingerprint", "Print deterministic non-secret BLAKE3 content hash of redacted configuration")
    p_fp.add_option("", "--config", "", "Path to config file (.json, .toml, .yaml)", False)
    p_fp.add_option("", "--profile", "development", "Configuration profile (default: development)", False)
    p_fp.add_option("", "--root", ".", "Allowed root directory for file confinement", False)
    root.add_command("fingerprint", p_fp, "Print non-secret BLAKE3 content fingerprint")

    # Subcommand: version
    p_ver: ArgumentParser = ArgumentParser("vault version", "Print vault library version")
    root.add_command("version", p_ver, "Print vault library version")

    # Subcommand: help
    p_help: ArgumentParser = ArgumentParser("vault help", "Show this help message")
    root.add_command("help", p_help, "Show this help message")

    return root

def print_help() -> None:
    print("VAULT — Secure Configuration & Secret Management CLI")
    print("Usage: vault <command> [options]")
    print("")
    print("Commands:")
    print("  validate     Validate configuration against schema, format, and optional signature")
    print("  explain      Explain configuration key provenance without secret leakage")
    print("  check-env    Check process environment against required keys")
    print("  fingerprint  Print non-secret BLAKE3 content hash of redacted config")
    print("  version      Print vault library version")
    print("  help         Show this help message")
    print("")
    print("Options:")
    print("  --config <path>          Path to config file (.json, .toml, .yaml)")
    print("  --profile <name>         Configuration profile (default: development)")
    print("  --root <dir>             Allowed root directory for file confinement")
    print("  --keys <k1,k2>           Comma-separated required keys for check-env")
    print("  --verify-ed25519 <hex>   64-char Ed25519 publisher public key")
    print("  --sig <hex>              128-char Ed25519 signature over config file")
    print("  --help, -h               Show help")

def print_version() -> None:
    print("vault version " + CLI_VERSION)

class CliOptions:
    command: str
    target_key: str
    config_path: str
    profile: str
    root_dir: str
    required_keys: list[str]
    pub_key_hex: str
    sig_hex: str
    parse_error: str

    def __init__(self: CliOptions) -> None:
        self.command = ""
        self.target_key = ""
        self.config_path = ""
        self.profile = "development"
        self.root_dir = "."
        self.required_keys = []
        self.pub_key_hex = ""
        self.sig_hex = ""
        self.parse_error = ""

def parse_cli_args(args: list[str]) -> CliOptions:
    opts: CliOptions = CliOptions()
    if len(args) == 0:
        opts.command = "help"
        return opts

    parser: ArgumentParser = _build_parser()
    try:
        ns: Namespace = parser.parse(args)
    except ArgumentError as err:
        opts.command = "__parse_error__"
        opts.parse_error = err.message
        return opts

    if ns.help_requested or ns.command == "help":
        opts.command = "help"
        return opts

    if ns.flag("version") or ns.command == "version":
        opts.command = "version"
        return opts

    if len(ns.command) == 0:
        opts.command = "help"
        return opts

    opts.command = ns.command
    if ns.has("config"):
        opts.config_path = ns.get_str("config")
    if ns.has("profile"):
        opts.profile = ns.get_str("profile")
    if ns.has("root"):
        opts.root_dir = ns.get_str("root")
    if ns.has("key"):
        opts.target_key = ns.get_str("key")
    if ns.has("verify_ed25519"):
        opts.pub_key_hex = ns.get_str("verify_ed25519")
    if ns.has("sig"):
        opts.sig_hex = ns.get_str("sig")
    if ns.has("keys"):
        raw_keys_str: str = ns.get_str("keys")
        raw_keys: list[str] = nox.strings.split(raw_keys_str, ",")
        k_idx: int = 0
        while k_idx < len(raw_keys):
            trimmed_k: str = nox.strings.trim(raw_keys[k_idx])
            if len(trimmed_k) > 0:
                opts.required_keys.append(trimmed_k)
            k_idx = k_idx + 1

    return opts

def _detect_format(config_path: str) -> str:
    if nox.strings.ends_with(config_path, ".json"):
        return "json"
    if nox.strings.ends_with(config_path, ".toml"):
        return "toml"
    if nox.strings.ends_with(config_path, ".yaml") or nox.strings.ends_with(config_path, ".yml"):
        return "yaml"
    if nox.strings.ends_with(config_path, ".env") or nox.strings.contains(config_path, ".env."):
        return "dotenv"
    return ""

def run_cli(args: list[str]) -> int:
    opts: CliOptions = parse_cli_args(args)

    if opts.command == "__parse_error__":
        print("ERROR: " + opts.parse_error)
        return 1

    if opts.command == "help":
        print_help()
        return 0

    if opts.command == "version":
        print_version()
        return 0

    if opts.command == "validate":
        if not is_valid_profile_name(opts.profile):
            print("ERROR: invalid profile name: " + opts.profile)
            return 1

        builder: ConfigBuilder = ConfigBuilder()
        builder.with_allowed_root(opts.root_dir)
        builder.with_profile(opts.profile)

        has_pub: bool = len(opts.pub_key_hex) > 0
        has_sig: bool = len(opts.sig_hex) > 0
        if has_pub != has_sig:
            print("ERROR: --verify-ed25519 and --sig must be supplied together")
            return 1

        if len(opts.config_path) > 0:
            fmt: str = _detect_format(opts.config_path)
            if len(fmt) == 0:
                print("ERROR: unsupported config file format: " + opts.config_path)
                return 1
            if has_pub and has_sig:
                builder.with_signed_file(opts.config_path, fmt, opts.pub_key_hex, opts.sig_hex, False)
            elif fmt == "json":
                builder.with_json_file(opts.config_path, False)
            elif fmt == "toml":
                builder.with_toml_file(opts.config_path, False)
            elif fmt == "yaml":
                builder.with_yaml_file(opts.config_path, False)
            elif fmt == "dotenv":
                builder.with_dotenv(opts.config_path, False)

        try:
            snapshot: ConfigSnapshot = builder.build()
            print("OK: configuration is valid (version: " + snapshot.version() + ")")
            return 0
        except ConfigError as err:
            print("ERROR: configuration validation failed: " + err.to_string())
            return 1
        except Exception:
            print("ERROR: unexpected error during configuration validation")
            return 1

    if opts.command == "explain":
        if len(opts.target_key) == 0:
            print("ERROR: explain command requires a configuration key argument")
            return 1

        builder: ConfigBuilder = ConfigBuilder()
        builder.with_allowed_root(opts.root_dir)
        builder.with_profile(opts.profile)

        if len(opts.config_path) > 0:
            if nox.strings.ends_with(opts.config_path, ".json"):
                builder.with_json_file(opts.config_path, False)
            elif nox.strings.ends_with(opts.config_path, ".toml"):
                builder.with_toml_file(opts.config_path, False)
            elif nox.strings.ends_with(opts.config_path, ".yaml") or nox.strings.ends_with(opts.config_path, ".yml"):
                builder.with_yaml_file(opts.config_path, False)

        try:
            snapshot: ConfigSnapshot = builder.build()
            # explain output never includes raw secret values
            print(snapshot.explain(opts.target_key))
            return 0
        except ConfigError as err:
            print("ERROR: cannot explain key: " + err.to_string())
            return 1

    if opts.command == "fingerprint":
        if not is_valid_profile_name(opts.profile):
            print("ERROR: invalid profile name: " + opts.profile)
            return 1

        builder: ConfigBuilder = ConfigBuilder()
        builder.with_allowed_root(opts.root_dir)
        builder.with_profile(opts.profile)

        if len(opts.config_path) > 0:
            fmt_fp: str = _detect_format(opts.config_path)
            if fmt_fp == "json":
                builder.with_json_file(opts.config_path, False)
            elif fmt_fp == "toml":
                builder.with_toml_file(opts.config_path, False)
            elif fmt_fp == "yaml":
                builder.with_yaml_file(opts.config_path, False)
            elif fmt_fp == "dotenv":
                builder.with_dotenv(opts.config_path, False)
            else:
                print("ERROR: unsupported config file format: " + opts.config_path)
                return 1

        try:
            snapshot: ConfigSnapshot = builder.build()
            print("blake3:" + snapshot.content_hash())
            return 0
        except ConfigError as err:
            print("ERROR: fingerprint failed: " + err.to_string())
            return 1

    if opts.command == "check-env":
        if len(opts.required_keys) == 0:
            print("ERROR: check-env requires --keys <k1,k2,...>")
            return 1

        missing_keys: list[str] = []
        k_idx: int = 0
        while k_idx < len(opts.required_keys):
            k_name: str = opts.required_keys[k_idx]
            try:
                val: str = nox.os.getenv(k_name)
                if len(val) == 0:
                    missing_keys.append(k_name)
            except OsError:
                missing_keys.append(k_name)
            k_idx = k_idx + 1

        if len(missing_keys) > 0:
            print("ERROR: missing required environment variables: " + nox.strings.join(missing_keys, ", "))
            return 1

        print("OK: all required environment variables present")
        return 0

    print("ERROR: unknown command: '" + opts.command + "'. Run 'vault --help' for usage.")
    return 1

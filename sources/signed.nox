# VAULT — Ed25519-Verified Configuration Source
# Module: sources.signed
# Verifies raw file bytes against a pinned Ed25519 publisher public key (nox.ed25519)
# BEFORE invoking any format parser (fail-closed pre-parse verification).

from core.types import ConfigEntry, ConfigValue, SourceOrigin, make_string, PRESENCE_NULL, PRESENCE_EMPTY, PRESENCE_SUPPLIED
from core.errors import ConfigError, ERR_CONFIG_PARSE_ERROR, ERR_CONFIG_SIGNATURE_INVALID
from sources.interface import ConfigSource
from sources.files import read_bounded_file
from sources.json import _json_to_config_value
from sources.toml import _toml_to_config_value
from sources.yaml import _yaml_to_config_value
from env.parser import parse_dotenv, EnvEntry, EnvParseError
from secrets.integrity import require_valid_ed25519
from nox.toml import TomlValue
from nox.yaml import YamlValue
import nox.json
import nox.toml
import nox.yaml

class SignedConfigSource(ConfigSource):
    path: str
    format_name: str
    pub_key_hex: str
    signature_hex: str
    allowed_root: str
    optional: bool

    def __init__(self: SignedConfigSource, path: str, format_name: str, pub_key_hex: str, signature_hex: str, allowed_root: str, optional: bool, rank: int, profile: str) -> None:
        self.id = path
        self.kind = "signed_" + format_name
        self.rank = rank
        self.profile = profile
        self.path = path
        self.format_name = format_name
        self.pub_key_hex = pub_key_hex
        self.signature_hex = signature_hex
        self.allowed_root = allowed_root
        self.optional = optional

    def set_allowed_root(self: SignedConfigSource, root: str) -> None:
        self.allowed_root = root

    def load(self: SignedConfigSource) -> list[ConfigEntry]:
        content: str = read_bounded_file(self.path, self.allowed_root, self.optional)
        entries: list[ConfigEntry] = []
        if len(content) == 0 and self.optional:
            return entries

        # Fail-closed Ed25519 verification prior to parsing
        require_valid_ed25519(content, self.pub_key_hex, self.signature_hex, self.path)

        origin: SourceOrigin = SourceOrigin(self.path, self.kind, self.profile, self.rank)

        if self.format_name == "dotenv":
            try:
                env_entries: list[EnvEntry] = parse_dotenv(content)
                idx: int = 0
                while idx < len(env_entries):
                    ee: EnvEntry = env_entries[idx]
                    p: int = PRESENCE_EMPTY if len(ee.value) == 0 else PRESENCE_SUPPLIED
                    entries.append(ConfigEntry(ee.key, make_string(ee.value), p, origin, False, False))
                    idx = idx + 1
                return entries
            except EnvParseError as err:
                raise ConfigError(ERR_CONFIG_PARSE_ERROR, self.path, err.to_string())

        if self.format_name == "json":
            try:
                jv: JsonValue = nox.json.parse(content)
            except Exception:
                raise ConfigError(ERR_CONFIG_PARSE_ERROR, self.path, "invalid signed JSON syntax")
            if not nox.json.is_object(jv):
                raise ConfigError(ERR_CONFIG_PARSE_ERROR, self.path, "root signed JSON entity must be an object")
            i: int = 0
            while i < nox.json.object_len(jv):
                k: str = nox.json.object_key(jv, i)
                cv: ConfigValue = _json_to_config_value(nox.json.object_value(jv, i))
                pr: int = PRESENCE_SUPPLIED
                if cv.kind == 1:
                    pr = PRESENCE_NULL
                elif cv.kind == 2 and len(cv.s) == 0:
                    pr = PRESENCE_EMPTY
                entries.append(ConfigEntry(k, cv, pr, origin, False, False))
                i = i + 1
            return entries

        if self.format_name == "toml":
            try:
                tv: TomlValue = nox.toml.parse(content)
            except Exception:
                raise ConfigError(ERR_CONFIG_PARSE_ERROR, self.path, "invalid signed TOML syntax")
            if tv.kind != 5:
                raise ConfigError(ERR_CONFIG_PARSE_ERROR, self.path, "root signed TOML document must be a table")
            t_keys: list[str] = tv.tbl.keys()
            ti: int = 0
            while ti < len(t_keys):
                k_t: str = t_keys[ti]
                cv_t: ConfigValue = _toml_to_config_value(tv.tbl[k_t])
                pr_t: int = PRESENCE_SUPPLIED
                if cv_t.kind == 1:
                    pr_t = PRESENCE_NULL
                elif cv_t.kind == 2 and len(cv_t.s) == 0:
                    pr_t = PRESENCE_EMPTY
                entries.append(ConfigEntry(k_t, cv_t, pr_t, origin, False, False))
                ti = ti + 1
            return entries

        if self.format_name == "yaml":
            try:
                yv: YamlValue = nox.yaml.parse(content)
            except Exception:
                raise ConfigError(ERR_CONFIG_PARSE_ERROR, self.path, "invalid signed YAML syntax")
            if yv.kind != 6:
                raise ConfigError(ERR_CONFIG_PARSE_ERROR, self.path, "root signed YAML document must be a mapping")
            y_keys: list[str] = yv.mapping.keys()
            yi: int = 0
            while yi < len(y_keys):
                k_y: str = y_keys[yi]
                cv_y: ConfigValue = _yaml_to_config_value(yv.mapping[k_y])
                pr_y: int = PRESENCE_SUPPLIED
                if cv_y.kind == 1:
                    pr_y = PRESENCE_NULL
                elif cv_y.kind == 2 and len(cv_y.s) == 0:
                    pr_y = PRESENCE_EMPTY
                entries.append(ConfigEntry(k_y, cv_y, pr_y, origin, False, False))
                yi = yi + 1
            return entries

        raise ConfigError(ERR_CONFIG_PARSE_ERROR, self.path, "unsupported signed config format: " + self.format_name)

# VAULT — Bounded Dotenv File Source
# Module: env.source

from core.types import ConfigEntry, ConfigValue, SourceOrigin, PRESENCE_SUPPLIED, PRESENCE_EMPTY, make_string
from core.errors import ConfigError, ERR_CONFIG_SOURCE_UNAVAILABLE, ERR_CONFIG_SIZE_LIMIT
from sources.interface import ConfigSource
from env.parser import parse_dotenv, EnvEntry, EnvParseError
from nox.fs import exists, metadata, read_to_string, FileMetadata

class DotenvSource(ConfigSource):
    path: str
    optional: bool

    def __init__(self: DotenvSource, path: str, optional: bool, rank: int, profile: str) -> None:
        self.id = path
        self.kind = "dotenv"
        self.rank = rank
        self.profile = profile
        self.path = path
        self.optional = optional

    def load(self: DotenvSource) -> list[ConfigEntry]:
        entries: list[ConfigEntry] = []
        if not exists(self.path):
            if self.optional:
                return entries
            raise ConfigError(ERR_CONFIG_SOURCE_UNAVAILABLE, self.path, "required dotenv file does not exist")

        meta: FileMetadata = metadata(self.path)
        if meta.size > 1048576: # 1 MiB bound
            raise ConfigError(ERR_CONFIG_SIZE_LIMIT, self.path, "dotenv file exceeds 1 MiB limit")

        content: str = read_to_string(self.path)
        env_entries: list[EnvEntry] = parse_dotenv(content)

        idx: int = 0
        while idx < len(env_entries):
            e: EnvEntry = env_entries[idx]
            presence: int = PRESENCE_SUPPLIED
            if len(e.value) == 0:
                presence = PRESENCE_EMPTY
            origin: SourceOrigin = SourceOrigin(self.path, "dotenv", self.profile, self.rank)
            entry: ConfigEntry = ConfigEntry(e.key, make_string(e.value), presence, origin, False, False)
            entries.append(entry)
            idx = idx + 1

        return entries

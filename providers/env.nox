# VAULT — Allowlist-Only Environment Secret Provider
# Module: providers.env

from nox.os import OsError
import nox.os
from providers.interface import SecretProvider, SecretFetchResult, ProviderHealth, make_fetch_success, make_fetch_not_found

def _is_allowed(target: str, allowed: list[str]) -> bool:
    idx: int = 0
    while idx < len(allowed):
        if allowed[idx] == target:
            return True
        idx = idx + 1
    return False

class EnvSecretProvider(SecretProvider):
    allowed_keys: list[str]
    key_mapping: dict[str, str]

    def __init__(self: EnvSecretProvider, allowed_keys: list[str], key_mapping: dict[str, str]) -> None:
        self.id = "env_secrets"
        self.provider_kind = "env"
        self.allowed_keys = allowed_keys
        self.key_mapping = key_mapping

    def get(self: EnvSecretProvider, key: str) -> SecretFetchResult:
        # 1. Determine target OS environment variable name
        env_var: str = key
        if key in self.key_mapping:
            env_var = self.key_mapping[key]

        # 2. Strict allowlist check: never query OS for disallowed variables
        if not _is_allowed(key, self.allowed_keys) and not _is_allowed(env_var, self.allowed_keys):
            return make_fetch_not_found(self.id)

        # 3. Read explicitly named environment variable
        try:
            val: str = nox.os.getenv(env_var)
            return make_fetch_success(val, key, self.id)
        except OsError:
            return make_fetch_not_found(self.id)

    def health(self: EnvSecretProvider) -> ProviderHealth:
        return ProviderHealth(True, "env provider healthy")

    def close(self: EnvSecretProvider) -> None:
        pass

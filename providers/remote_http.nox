# VAULT — Remote HTTPS Secret Provider with SSRF Protection
# Module: providers.remote_http

from core.errors import ConfigError, ERR_CONFIG_PROVIDER_UNAVAILABLE, ERR_CONFIG_SECRET_SOURCE_DENIED, ERR_CONFIG_SIZE_LIMIT
from providers.interface import SecretProvider, SecretFetchResult, ProviderHealth, make_fetch_success, make_fetch_not_found, make_fetch_error
import nox.strings
import nox.http
from nox.http import HttpError
from nox.process import Command, Output

MAX_REMOTE_RESPONSE_SIZE: int = 65536 # 64 KiB ceiling

class HttpResponse:
    status_code: int
    headers: dict[str, str]
    body: str
    is_redirect: bool
    redirect_location: str

    def __init__(self: HttpResponse, status_code: int, headers: dict[str, str], body: str, is_redirect: bool, redirect_location: str) -> None:
        self.status_code = status_code
        self.headers = headers
        self.body = body
        self.is_redirect = is_redirect
        self.redirect_location = redirect_location

class HttpTransport:
    transport_name: str

    def __init__(self: HttpTransport, name: str) -> None:
        self.transport_name = name

    def send_request(self: HttpTransport, method: str, url: str, headers: dict[str, str], body: str, timeout_ms: int, connect_ip: str = "", tls_server_name: str = "") -> HttpResponse:
        empty_h: dict[str, str] = {}
        return HttpResponse(500, empty_h, "base transport unimplemented", False, "")

class StandardHttpTransport(HttpTransport):
    enforce_socket_pinning: bool

    def __init__(self: StandardHttpTransport, enforce_socket_pinning: bool = False) -> None:
        self.transport_name = "standard_nox_http"
        self.enforce_socket_pinning = enforce_socket_pinning

    def send_request(self: StandardHttpTransport, method: str, url: str, headers: dict[str, str], body: str, timeout_ms: int, connect_ip: str = "", tls_server_name: str = "") -> HttpResponse:
        # NET-07: If socket-level IP pinning is strictly required by caller policy,
        # fail closed because nox.http stdlib does not expose raw socket binding primitives.
        if self.enforce_socket_pinning and len(connect_ip) > 0 and len(tls_server_name) > 0:
            if connect_ip != tls_server_name:
                raise ConfigError(
                    ERR_CONFIG_PROVIDER_UNAVAILABLE,
                    url,
                    "socket-level IP pinning is not supported by standard nox.http; use a pinning-capable transport or disable strict enforce_socket_pinning"
                )

        try:
            res: nox.http.HttpResponse = nox.http.request(method, url, body, headers, timeout_ms)
            is_redir: bool = res.status == 301 or res.status == 302 or res.status == 307 or res.status == 308
            redir_loc: str = ""
            if is_redir:
                if "Location" in res.headers:
                    redir_loc = res.headers["Location"]
                elif "location" in res.headers:
                    redir_loc = res.headers["location"]

            return HttpResponse(res.status, res.headers, res.body, is_redir, redir_loc)
        except HttpError as err:
            raise ConfigError(ERR_CONFIG_PROVIDER_UNAVAILABLE, url, "http network or timeout error")
        except Exception:
            raise ConfigError(ERR_CONFIG_PROVIDER_UNAVAILABLE, url, "unexpected http transport error")

class StrictPinnedHttpTransport(HttpTransport):
    def __init__(self: StrictPinnedHttpTransport) -> None:
        self.transport_name = "strict_socket_pinned"

    def send_request(self: StrictPinnedHttpTransport, method: str, url: str, headers: dict[str, str], body: str, timeout_ms: int, connect_ip: str = "", tls_server_name: str = "") -> HttpResponse:
        # NET-10: Strict Socket Pinning Contract
        # Standard nox.http does not expose raw socket-level IP binding.
        # Strict mode mandates that without an underlying pinning-capable socket transport,
        # connection must fail closed immediately to eliminate DNS rebinding risk.
        raise ConfigError(
            ERR_CONFIG_PROVIDER_UNAVAILABLE,
            url,
            "strict socket-level IP pinning required but not supported by standard nox.http runtime; connection rejected fail-closed"
        )

class MockHttpTransport(HttpTransport):
    routes: dict[str, HttpResponse]
    call_count: int
    should_timeout: bool
    last_requested_url: str
    last_connect_ip: str
    last_tls_server_name: str

    def __init__(self: MockHttpTransport) -> None:
        self.transport_name = "mock"
        self.routes = {}
        self.call_count = 0
        self.should_timeout = False
        self.last_requested_url = ""
        self.last_connect_ip = ""
        self.last_tls_server_name = ""

    def add_route(self: MockHttpTransport, url: str, status_code: int, body: str, redirect_location: str) -> None:
        is_redir: bool = status_code == 301 or status_code == 302 or status_code == 307 or status_code == 308
        h: dict[str, str] = {}
        if is_redir:
            h["Location"] = redirect_location
        self.routes[url] = HttpResponse(status_code, h, body, is_redir, redirect_location)

    def set_timeout(self: MockHttpTransport, timeout: bool) -> None:
        self.should_timeout = timeout

    def send_request(self: MockHttpTransport, method: str, url: str, headers: dict[str, str], body: str, timeout_ms: int, connect_ip: str = "", tls_server_name: str = "") -> HttpResponse:
        self.call_count = self.call_count + 1
        self.last_requested_url = url
        self.last_connect_ip = connect_ip
        self.last_tls_server_name = tls_server_name

        if self.should_timeout:
            raise ConfigError(ERR_CONFIG_PROVIDER_UNAVAILABLE, url, "transport read timeout")

        if url in self.routes:
            return self.routes[url]

        # Support virtual-host lookup for DNS-pinned requests if caller rewrote URL
        if "Host" in headers and nox.strings.starts_with(url, "https://"):
            vhost: str = headers["Host"]
            without_scheme: str = url[8:len(url)]
            slash_idx: int = nox.strings.index_of(without_scheme, "/")
            if slash_idx >= 0:
                path_part: str = without_scheme[slash_idx:len(without_scheme)]
                vhost_url: str = "https://" + vhost + path_part
                if vhost_url in self.routes:
                    return self.routes[vhost_url]

        empty_h: dict[str, str] = {}
        return HttpResponse(404, empty_h, "route not found", False, "")

def is_all_digits(s: str) -> bool:
    if len(s) == 0:
        return False
    idx: int = 0
    while idx < len(s):
        ch: str = s[idx]
        if ch < "0" or ch > "9":
            return False
        idx = idx + 1
    return True

def hex_val(ch: str) -> int:
    if ch == "0":
        return 0
    if ch == "1":
        return 1
    if ch == "2":
        return 2
    if ch == "3":
        return 3
    if ch == "4":
        return 4
    if ch == "5":
        return 5
    if ch == "6":
        return 6
    if ch == "7":
        return 7
    if ch == "8":
        return 8
    if ch == "9":
        return 9
    if ch == "a" or ch == "A":
        return 10
    if ch == "b" or ch == "B":
        return 11
    if ch == "c" or ch == "C":
        return 12
    if ch == "d" or ch == "D":
        return 13
    if ch == "e" or ch == "E":
        return 14
    if ch == "f" or ch == "F":
        return 15
    return -1

def parse_hextet(s: str) -> int:
    if len(s) == 0 or len(s) > 4:
        return -1
    v: int = 0
    idx: int = 0
    while idx < len(s):
        h: int = hex_val(s[idx:idx + 1])
        if h < 0:
            return -1
        v = (v << 4) | h
        idx = idx + 1
    return v

def _find_last_colon(s: str) -> int:
    idx: int = len(s) - 1
    while idx >= 0:
        if s[idx:idx + 1] == ":":
            return idx
        idx = idx - 1
    return -1

def parse_ipv6_hextets(addr: str) -> list[int]:
    cleaned: str = nox.strings.trim(addr)
    if nox.strings.starts_with(cleaned, "[") and nox.strings.ends_with(cleaned, "]"):
        cleaned = cleaned[1:len(cleaned) - 1]

    # NET-08: Reject triple or more consecutive colons (e.g. 2001:4860:::8888)
    if nox.strings.contains(cleaned, ":::"):
        return []

    # Reject single leading or trailing colon
    if nox.strings.starts_with(cleaned, ":") and not nox.strings.starts_with(cleaned, "::"):
        return []
    if nox.strings.ends_with(cleaned, ":") and not nox.strings.ends_with(cleaned, "::"):
        return []

    embedded_ipv4: list[int] = []
    last_colon: int = _find_last_colon(cleaned)
    if last_colon >= 0:
        tail: str = cleaned[last_colon + 1:len(cleaned)]
        if nox.strings.contains(tail, "."):
            parts4: list[str] = nox.strings.split(tail, ".")
            if len(parts4) != 4:
                return []
            if len(parts4[0]) == 0 or len(parts4[1]) == 0 or len(parts4[2]) == 0 or len(parts4[3]) == 0:
                return []
            if not is_all_digits(parts4[0]) or not is_all_digits(parts4[1]) or not is_all_digits(parts4[2]) or not is_all_digits(parts4[3]):
                return []
            p0: int = int(parts4[0])
            p1: int = int(parts4[1])
            p2: int = int(parts4[2])
            p3: int = int(parts4[3])
            if p0 < 0 or p0 > 255 or p1 < 0 or p1 > 255 or p2 < 0 or p2 > 255 or p3 < 0 or p3 > 255:
                return []
            embedded_ipv4.append((p0 << 8) | p1)
            embedded_ipv4.append((p2 << 8) | p3)
            if last_colon == 1 and nox.strings.starts_with(cleaned, "::"):
                cleaned = "::"
            else:
                cleaned = cleaned[0:last_colon]

    c_idx1: int = nox.strings.index_of(cleaned, "::")
    has_double_colon: bool = c_idx1 >= 0
    if has_double_colon:
        rest: str = cleaned[c_idx1 + 2:len(cleaned)]
        if nox.strings.contains(rest, "::"):
            return []
        left_str: str = cleaned[0:c_idx1]
        right_str: str = rest

        left_blocks: list[int] = []
        if len(left_str) > 0:
            for part in nox.strings.split(left_str, ":"):
                if len(part) == 0:
                    return []
                v: int = parse_hextet(part)
                if v < 0:
                    return []
                left_blocks.append(v)

        right_blocks: list[int] = []
        if len(right_str) > 0:
            for part in nox.strings.split(right_str, ":"):
                if len(part) == 0:
                    return []
                v2: int = parse_hextet(part)
                if v2 < 0:
                    return []
                right_blocks.append(v2)

        total_given: int = len(left_blocks) + len(right_blocks) + len(embedded_ipv4)
        if total_given > 7:
            return []
        missing: int = 8 - total_given

        result: list[int] = []
        for b in left_blocks:
            result.append(b)
        while missing > 0:
            result.append(0)
            missing = missing - 1
        for b in right_blocks:
            result.append(b)
        for b in embedded_ipv4:
            result.append(b)
        return result
    else:
        blocks: list[int] = []
        for part in nox.strings.split(cleaned, ":"):
            if len(part) == 0:
                return []
            v3: int = parse_hextet(part)
            if v3 < 0:
                return []
            blocks.append(v3)
        for b in embedded_ipv4:
            blocks.append(b)
        if len(blocks) != 8:
            return []
        return blocks

def parse_ipv4_int(ip: str) -> int:
    parts: list[str] = nox.strings.split(ip, ".")
    if len(parts) != 4:
        return -1
    idx: int = 0
    res: int = 0
    while idx < 4:
        part: str = parts[idx]
        if len(part) == 0 or len(part) > 3:
            return -1
        if not is_all_digits(part):
            return -1
        if len(part) > 1 and nox.strings.starts_with(part, "0"):
            return -1
        val: int = int(part)
        if val < 0 or val > 255:
            return -1
        res = (res << 8) | val
        idx = idx + 1
    return res

def validate_ipv4_int(ip_int: int) -> bool:
    if ip_int < 0:
        return False
    # Unroutable / Zero: 0.0.0.0/8
    if (ip_int & 4278190080) == 0:
        return False
    # Loopback: 127.0.0.0/8
    if (ip_int & 4278190080) == 2130706432:
        return False
    # Broadcast: 255.255.255.255
    if ip_int == 4294967295:
        return False
    # RFC 1918 Private: 10.0.0.0/8
    if (ip_int & 4278190080) == 167772160:
        return False
    # RFC 1918 Private: 172.16.0.0/12
    if (ip_int & 4293918720) == 2886729728:
        return False
    # RFC 1918 Private: 192.168.0.0/16
    if (ip_int & 4294901760) == 3232235520:
        return False
    # Cloud Link-Local Metadata (AWS/GCP/Azure): 169.254.0.0/16
    if (ip_int & 4294901760) == 2851995648:
        return False
    # Carrier-Grade NAT (CGNAT): 100.64.0.0/10
    if (ip_int & 4290772992) == 1681915904:
        return False
    # Multicast: 224.0.0.0/4
    if (ip_int & 4026531840) == 3758096384:
        return False
    # Reserved: 240.0.0.0/4
    if (ip_int & 4026531840) == 4026531840:
        return False
    # Benchmark Network: 198.18.0.0/15
    if (ip_int & 4294836224) == 3323068416:
        return False
    # Documentation: TEST-NET-1 (192.0.2.0/24)
    if (ip_int & 4294967040) == 3221225984:
        return False
    # Documentation: TEST-NET-2 (198.51.100.0/24)
    if (ip_int & 4294967040) == 3325256704:
        return False
    # Documentation: TEST-NET-3 (203.0.113.0/24)
    if (ip_int & 4294967040) == 3405803776:
        return False
    # Valid public IPv4
    return True

def is_numeric_or_obfuscated_host(host: str) -> bool:
    # 1. Hex prefix
    if nox.strings.contains(host, "0x") or nox.strings.contains(host, "0X"):
        return True

    # 2. Pure integer/dword host (e.g. 2130706433 or 0)
    if is_all_digits(host):
        return True

    # 3. Dotted numeric checks
    if nox.strings.contains(host, "."):
        parts: list[str] = nox.strings.split(host, ".")
        all_numeric: bool = True
        idx: int = 0
        while idx < len(parts):
            if not is_all_digits(parts[idx]):
                all_numeric = False
            idx = idx + 1

        if all_numeric:
            # Abbreviated IPs like 127.1 or 10.1
            if len(parts) != 4:
                return True
            # Octal leading zero in any octet (e.g. 0177.0.0.1)
            p_idx: int = 0
            while p_idx < len(parts):
                part: str = parts[p_idx]
                if len(part) > 1 and nox.strings.starts_with(part, "0"):
                    return True
                p_idx = p_idx + 1

    return False

def is_ip_literal(s: str) -> bool:
    # NET-12: Exact RFC 4291 IPv6 and 32-bit IPv4 literal parser
    cleaned: str = nox.strings.trim(s)
    if len(cleaned) == 0:
        return False
    if nox.strings.starts_with(cleaned, "[") and nox.strings.ends_with(cleaned, "]"):
        cleaned = cleaned[1:len(cleaned) - 1]

    if nox.strings.contains(cleaned, ":"):
        hextets: list[int] = parse_ipv6_hextets(cleaned)
        return len(hextets) == 8

    if nox.strings.contains(cleaned, "."):
        v4: int = parse_ipv4_int(cleaned)
        return v4 >= 0

    return False

def validate_resolved_ip(ip: str) -> bool:
    # NET-09 / NET-12: Strict IP address validation ONLY (IPv4 & IPv6).
    # Rejects malformed IPs, loopback, private, link-local, cloud-metadata.
    # NEVER returns True for hostnames (e.g. vault.example.com)!
    cleaned: str = nox.strings.trim(ip)
    if len(cleaned) == 0:
        return False

    # Must be a syntactically valid IP literal first
    if not is_ip_literal(cleaned):
        return False

    # 1. IPv6 Validation
    if nox.strings.contains(cleaned, ":"):
        hextets: list[int] = parse_ipv6_hextets(cleaned)
        if len(hextets) != 8:
            return False

        h0: int = hextets[0]
        h1: int = hextets[1]
        h2: int = hextets[2]
        h3: int = hextets[3]
        h4: int = hextets[4]
        h5: int = hextets[5]
        h6: int = hextets[6]
        h7: int = hextets[7]

        # Unspecified: ::/128
        if h0 == 0 and h1 == 0 and h2 == 0 and h3 == 0 and h4 == 0 and h5 == 0 and h6 == 0 and h7 == 0:
            return False
        # Loopback: ::1/128
        if h0 == 0 and h1 == 0 and h2 == 0 and h3 == 0 and h4 == 0 and h5 == 0 and h6 == 0 and h7 == 1:
            return False
        # Link-local unicast: fe80::/10 (0xfe80 - 0xfebf)
        if (h0 & 65472) == 65152:
            return False
        # Unique Local Address (ULA) / Private: fc00::/7 (0xfc00 - 0xfdff)
        if (h0 & 65024) == 64512:
            return False
        # Multicast: ff00::/8
        if (h0 & 65280) == 65280:
            return False
        # Discard prefix: 100::/64
        if h0 == 256 and h1 == 0 and h2 == 0 and h3 == 0:
            return False
        # Documentation: 2001:db8::/32
        if h0 == 8193 and h1 == 3512:
            return False
        # Benchmarking: 2001:2::/48
        if h0 == 8193 and h1 == 2:
            return False
        # IPv4-mapped IPv6: ::ffff:0:0/96
        if h0 == 0 and h1 == 0 and h2 == 0 and h3 == 0 and h4 == 0 and h5 == 65535:
            emb4: int = (h6 << 16) | h7
            return validate_ipv4_int(emb4)
        # IPv4-compatible IPv6: ::0:0/96
        if h0 == 0 and h1 == 0 and h2 == 0 and h3 == 0 and h4 == 0 and h5 == 0 and (h6 != 0 or h7 > 1):
            emb4_c: int = (h6 << 16) | h7
            return validate_ipv4_int(emb4_c)
        # 6to4: 2002::/16
        if h0 == 8194:
            emb4_6to4: int = (h1 << 16) | h2
            return validate_ipv4_int(emb4_6to4)
        # Teredo: 2001:0000::/32
        if h0 == 8193 and h1 == 0:
            emb4_teredo: int = (~((h6 << 16) | h7)) & 4294967295
            return validate_ipv4_int(emb4_teredo)

        return True

    # 2. IPv4 Validation
    if is_numeric_or_obfuscated_host(cleaned):
        return False

    is_dotted_numeric: bool = False
    if nox.strings.contains(cleaned, "."):
        first_char: str = cleaned[0:1]
        if first_char >= "0" and first_char <= "9":
            is_dotted_numeric = True

    if is_dotted_numeric:
        ip_int: int = parse_ipv4_int(cleaned)
        if ip_int == -1:
            return False
        return validate_ipv4_int(ip_int)

    # Any non-IP (including hostnames like 'vault.example.com') is NOT a valid IP literal!
    return False

def is_valid_hostname(host: str) -> bool:
    # RFC 1123 Hostname Validation
    cleaned: str = nox.strings.trim(host)
    if len(cleaned) == 0 or len(cleaned) > 253:
        return False
    if is_ip_literal(cleaned):
        return False
    if cleaned == "localhost" or nox.strings.ends_with(cleaned, ".localhost"):
        return False
    if nox.strings.starts_with(cleaned, ".") or nox.strings.ends_with(cleaned, "."):
        return False
    if nox.strings.starts_with(cleaned, "-") or nox.strings.ends_with(cleaned, "-"):
        return False
    if is_numeric_or_obfuscated_host(cleaned):
        return False

    h_idx: int = 0
    while h_idx < len(cleaned):
        c: str = cleaned[h_idx:h_idx + 1]
        is_alpha: bool = (c >= "a" and c <= "z") or (c >= "A" and c <= "Z")
        is_num: bool = (c >= "0" and c <= "9")
        is_special: bool = (c == "." or c == "-")
        if not (is_alpha or is_num or is_special):
            return False
        h_idx = h_idx + 1

    labels: list[str] = nox.strings.split(cleaned, ".")
    l_idx: int = 0
    while l_idx < len(labels):
        lab: str = labels[l_idx]
        if len(lab) == 0 or len(lab) > 63:
            return False
        if nox.strings.starts_with(lab, "-") or nox.strings.ends_with(lab, "-"):
            return False
        l_idx = l_idx + 1

    return True

class DnsResolver:
    resolver_name: str
    last_error: str
    last_exit_code: int

    def __init__(self: DnsResolver, name: str) -> None:
        self.resolver_name = name
        self.last_error = ""
        self.last_exit_code = 0

    def resolve(self: DnsResolver, host: str) -> list[str]:
        # NET-09 / NET-12: Fail-closed base resolver with diagnostic tracking
        self.last_error = ""
        self.last_exit_code = 0
        if is_ip_literal(host):
            res_lit: list[str] = [host]
            return res_lit
        self.last_error = "DNS_BASE_RESOLVER_NO_RECORDS"
        res_empty: list[str] = []
        return res_empty

class StaticDnsResolver(DnsResolver):
    records: dict[str, list[str]]

    def __init__(self: StaticDnsResolver) -> None:
        self.resolver_name = "static"
        self.records = {}
        self.last_error = ""
        self.last_exit_code = 0

    def add_record(self: StaticDnsResolver, host: str, ips: list[str]) -> None:
        self.records[host] = ips

    def resolve(self: StaticDnsResolver, host: str) -> list[str]:
        self.last_error = ""
        self.last_exit_code = 0
        if is_ip_literal(host):
            res_lit: list[str] = [host]
            return res_lit
        if host in self.records:
            return self.records[host]
        self.last_error = "STATIC_DNS_UNMAPPED_HOST"
        res_empty: list[str] = []
        return res_empty

class SystemDnsResolver(DnsResolver):
    def __init__(self: SystemDnsResolver) -> None:
        self.resolver_name = "system"
        self.last_error = ""
        self.last_exit_code = 0

    def resolve(self: SystemDnsResolver, host: str) -> list[str]:
        self.last_error = ""
        self.last_exit_code = 0

        # NET-12: Only genuine IP literals bypass OS DNS lookup!
        if is_ip_literal(host):
            res_ip: list[str] = [host]
            return res_ip

        resolved: list[str] = []
        try:
            out: Output = Command("nslookup").arg(host).run()
            self.last_exit_code = out.status
            if out.success():
                lines: list[str] = nox.strings.split(out.stdout, "\n")
                seen_name: bool = False
                for line in lines:
                    trimmed: str = nox.strings.trim(line)
                    if nox.strings.starts_with(trimmed, "Name:") or nox.strings.starts_with(trimmed, "name:"):
                        seen_name = True
                    elif seen_name:
                        cand: str = ""
                        if nox.strings.starts_with(trimmed, "Address:") or nox.strings.starts_with(trimmed, "address:"):
                            c_idx: int = nox.strings.index_of(trimmed, ":")
                            cand = nox.strings.trim(trimmed[c_idx + 1:len(trimmed)])
                        elif nox.strings.starts_with(trimmed, "Addresses:") or nox.strings.starts_with(trimmed, "addresses:"):
                            c_idx2: int = nox.strings.index_of(trimmed, ":")
                            cand = nox.strings.trim(trimmed[c_idx2 + 1:len(trimmed)])
                        elif is_ip_literal(trimmed):
                            # Continuation lines in Windows nslookup under 'Addresses:'
                            cand = trimmed

                        if len(cand) > 0:
                            # Strip any port or comment delimiter e.g. '#53'
                            hash_idx: int = nox.strings.index_of(cand, "#")
                            if hash_idx >= 0:
                                cand = nox.strings.trim(cand[0:hash_idx])
                            # Full A or AAAA IPv6 literal preserved without colon truncation
                            if is_ip_literal(cand) and cand not in resolved:
                                resolved.append(cand)

                if len(resolved) == 0:
                    self.last_error = "DNS_NO_ADDRESS_RECORDS"
            else:
                self.last_error = "DNS_QUERY_FAILED: status=" + str(out.status)
        except Exception:
            self.last_error = "DNS_EXECUTABLE_UNAVAILABLE_OR_SPAWN_ERROR"

        # FAIL CLOSED: If resolution produced zero addresses, return empty list!
        # NEVER return [host] fallback!
        return resolved

def _extract_authority(https_url: str) -> str:
    # URL is verified to start with https:// (len 8)
    without_scheme: str = https_url[8:len(https_url)]
    # Stop at '/', '?', or '#'
    end_idx: int = len(without_scheme)
    s_idx: int = nox.strings.index_of(without_scheme, "/")
    if s_idx >= 0 and s_idx < end_idx:
        end_idx = s_idx
    q_idx: int = nox.strings.index_of(without_scheme, "?")
    if q_idx >= 0 and q_idx < end_idx:
        end_idx = q_idx
    h_idx: int = nox.strings.index_of(without_scheme, "#")
    if h_idx >= 0 and h_idx < end_idx:
        end_idx = h_idx

    return without_scheme[0:end_idx]

def validate_https_endpoint(url: str, allowlist: list[str]) -> bool:
    # 1. Scheme check: HTTPS only
    if not nox.strings.starts_with(url, "https://"):
        return False

    authority: str = _extract_authority(url)

    # 2. Strict Userinfo / Credential Rejection (RFC 3986 & SSRF protection)
    # Reject '@' in authority to prevent userinfo spoofing (e.g. https://allowed.com:pass@evil.com/)
    if nox.strings.contains(authority, "@"):
        return False

    # 3. Reject URL-encoded characters in authority to prevent hostname obfuscation (NET-02)
    if nox.strings.contains(authority, "%"):
        return False

    # 4. Parse host and optional port, accounting for bracketed IPv6 notation
    host: str = authority
    port: str = ""
    if nox.strings.starts_with(authority, "["):
        r_bracket: int = nox.strings.index_of(authority, "]")
        if r_bracket < 0:
            return False
        host = authority[0:r_bracket + 1]
        if len(authority) > r_bracket + 1:
            after_bracket: str = authority[r_bracket + 1:len(authority)]
            if nox.strings.starts_with(after_bracket, ":"):
                port = after_bracket[1:len(after_bracket)]
    else:
        colon_idx: int = nox.strings.index_of(authority, ":")
        if colon_idx >= 0:
            host = authority[0:colon_idx]
            port = authority[colon_idx + 1:len(authority)]

    # 5. NET-03: SSRF Rejection of numeric or obfuscated hosts (hex, decimal integer IP, octal, abbreviated IPs)
    if is_numeric_or_obfuscated_host(host):
        return False

    # 6. NET-09: Host validation — either a valid routable IP literal or a valid RFC 1123 hostname
    if is_ip_literal(host):
        if not validate_resolved_ip(host):
            return False
    else:
        if not is_valid_hostname(host):
            return False

    # 7. Localhost names
    if host == "localhost" or nox.strings.ends_with(host, ".localhost"):
        return False

    # 8. Allowlist membership check (exact host or exact authority match)
    matched: bool = False
    idx: int = 0
    while idx < len(allowlist):
        allowed: str = allowlist[idx]
        if host == allowed or authority == allowed:
            matched = True
        idx = idx + 1

    return matched

def _validate_secret_key_path(key: str) -> None:
    if len(key) == 0:
        raise ConfigError(ERR_CONFIG_PROVIDER_UNAVAILABLE, key, "empty secret key not permitted in remote endpoint")
    if nox.strings.contains(key, "/") or nox.strings.contains(key, "\\"):
        raise ConfigError(ERR_CONFIG_PROVIDER_UNAVAILABLE, key, "remote secret key cannot contain path traversal or separator characters")
    if nox.strings.contains(key, ".."):
        raise ConfigError(ERR_CONFIG_PROVIDER_UNAVAILABLE, key, "remote secret key cannot contain directory traversal elements")
    if nox.strings.contains(key, "?") or nox.strings.contains(key, "#"):
        raise ConfigError(ERR_CONFIG_PROVIDER_UNAVAILABLE, key, "remote secret key cannot contain query or fragment delimiters")
    if nox.strings.contains(key, " ") or nox.strings.contains(key, "\t"):
        raise ConfigError(ERR_CONFIG_PROVIDER_UNAVAILABLE, key, "remote secret key cannot contain whitespace")
    if nox.strings.contains(key, "%"):
        raise ConfigError(ERR_CONFIG_PROVIDER_UNAVAILABLE, key, "remote secret key cannot contain URL-encoded sequences")
    if nox.strings.contains(key, "\0"):
        raise ConfigError(ERR_CONFIG_PROVIDER_UNAVAILABLE, key, "remote secret key cannot contain null bytes")

class RemoteHttpSecretProvider(SecretProvider):
    base_url: str
    allowed_hosts: list[str]
    auth_header_name: str
    auth_token: str
    timeout_ms: int
    max_retries: int
    transport: HttpTransport
    dns_resolver: DnsResolver
    strict_pinning: bool

    def __init__(self: RemoteHttpSecretProvider, id: str, base_url: str, allowed_hosts: list[str], auth_header_name: str, auth_token: str, transport: HttpTransport | None, dns_resolver: DnsResolver | None = None, strict_pinning: bool = False) -> None:
        self.id = id
        self.provider_kind = "remote_http"
        self.base_url = base_url
        self.allowed_hosts = allowed_hosts
        self.auth_header_name = auth_header_name
        self.auth_token = auth_token
        self.timeout_ms = 5000
        self.max_retries = 3
        self.strict_pinning = strict_pinning

        if transport is not None:
            if strict_pinning and transport.transport_name == "standard_nox_http":
                self.transport = StrictPinnedHttpTransport()
            else:
                self.transport = transport
        else:
            if strict_pinning:
                self.transport = StrictPinnedHttpTransport()
            else:
                self.transport = StandardHttpTransport(enforce_socket_pinning=False)

        if dns_resolver is not None:
            self.dns_resolver = dns_resolver
        else:
            self.dns_resolver = SystemDnsResolver()

        # Initial SSRF / allowlist check
        if not validate_https_endpoint(base_url, allowed_hosts):
            raise ConfigError(ERR_CONFIG_PROVIDER_UNAVAILABLE, id, "endpoint is not an allowed HTTPS target or violates SSRF protection")

    def get(self: RemoteHttpSecretProvider, key: str) -> SecretFetchResult:
        try:
            _validate_secret_key_path(key)
        except ConfigError as err:
            return make_fetch_error(err.code, err.message, self.id)

        current_url: str = self.base_url + "/" + key
        headers: dict[str, str] = {}
        headers[self.auth_header_name] = self.auth_token
        headers["Accept"] = "application/json"

        attempts: int = 0
        while attempts < self.max_retries:
            attempts = attempts + 1
            try:
                # NET-04 & NET-09: Pre-Flight DNS Resolution, SSRF Check & DNS Pinning
                authority: str = _extract_authority(current_url)
                host: str = authority
                port: str = ""
                if nox.strings.starts_with(authority, "["):
                    r_br: int = nox.strings.index_of(authority, "]")
                    if r_br >= 0:
                        host = authority[0:r_br + 1]
                        if len(authority) > r_br + 1:
                            after_br: str = authority[r_br + 1:len(authority)]
                            if nox.strings.starts_with(after_br, ":"):
                                port = after_br[1:len(after_br)]
                else:
                    c_idx: int = nox.strings.index_of(authority, ":")
                    if c_idx >= 0:
                        host = authority[0:c_idx]
                        port = authority[c_idx + 1:len(authority)]

                resolved_ips: list[str] = self.dns_resolver.resolve(host)
                if len(resolved_ips) == 0:
                    diag: str = "DNS resolution failed or produced zero addresses: rejected fail-closed"
                    if len(self.dns_resolver.last_error) > 0:
                        diag = diag + " (" + self.dns_resolver.last_error + ")"
                    return make_fetch_error(ERR_CONFIG_PROVIDER_UNAVAILABLE, diag, self.id)

                r_idx: int = 0
                while r_idx < len(resolved_ips):
                    c_ip: str = resolved_ips[r_idx]
                    if not validate_resolved_ip(c_ip):
                        return make_fetch_error(ERR_CONFIG_PROVIDER_UNAVAILABLE, "DNS resolution produced prohibited or private IP: SSRF blocked", self.id)
                    r_idx = r_idx + 1

                # NET-05 & NET-10: Dispatch to validated authentic URL with connect_ip and tls_server_name
                pinned_ip: str = resolved_ips[0]
                headers["Host"] = authority
                resp: HttpResponse = self.transport.send_request("GET", current_url, headers, "", self.timeout_ms, pinned_ip, host)

                # 1. Handle HTTP Redirects (PROVIDER-02): Validate new location before sending credentials
                if resp.is_redirect:
                    redir_target: str = resp.redirect_location
                    if not validate_https_endpoint(redir_target, self.allowed_hosts):
                        return make_fetch_error(ERR_CONFIG_PROVIDER_UNAVAILABLE, "redirect to unapproved or non-HTTPS endpoint blocked", self.id)
                    current_url = redir_target
                    # Continue loop to follow approved redirect
                elif resp.status_code == 200:
                    # 2. Successful response: enforce response size ceiling (64 KiB in actual bytes)
                    if nox.strings.byte_len(resp.body) > MAX_REMOTE_RESPONSE_SIZE:
                        return make_fetch_error(ERR_CONFIG_SIZE_LIMIT, "remote secret response exceeds 64 KiB ceiling", self.id)
                    clean_secret: str = nox.strings.trim(resp.body)
                    return make_fetch_success(clean_secret, key, self.id)
                elif resp.status_code == 401 or resp.status_code == 403:
                    # 3. Auth error: Never leak the auth token in error output!
                    return make_fetch_error(ERR_CONFIG_SECRET_SOURCE_DENIED, "remote provider authentication rejected", self.id)
                elif resp.status_code == 404:
                    # 4. Absent secret
                    return make_fetch_not_found(self.id)
                else:
                    # Server error (5xx): retry if attempts remain
                    pass

            except ConfigError as err:
                if attempts >= self.max_retries:
                    return make_fetch_error(ERR_CONFIG_PROVIDER_UNAVAILABLE, "remote provider timeout or network failure", self.id)
            except Exception:
                if attempts >= self.max_retries:
                    return make_fetch_error(ERR_CONFIG_PROVIDER_UNAVAILABLE, "remote provider request failed", self.id)

        # Retries exhausted (PROVIDER-03)
        return make_fetch_error(ERR_CONFIG_PROVIDER_UNAVAILABLE, "remote provider retries exhausted", self.id)

    def health(self: RemoteHttpSecretProvider) -> ProviderHealth:
        if not validate_https_endpoint(self.base_url, self.allowed_hosts):
            return ProviderHealth(False, "configured endpoint violates allowlist or SSRF policy")
        return ProviderHealth(True, "remote provider configuration healthy")

    def close(self: RemoteHttpSecretProvider) -> None:
        self.auth_token = ""

# VAULT — Remote HTTPS Secret Provider with SSRF Protection
# Module: providers.remote_http

from core.errors import ConfigError, ERR_CONFIG_PROVIDER_UNAVAILABLE, ERR_CONFIG_SECRET_SOURCE_DENIED, ERR_CONFIG_SIZE_LIMIT
from providers.interface import SecretProvider, SecretFetchResult, ProviderHealth, make_fetch_success, make_fetch_not_found, make_fetch_error
import nox.strings
import nox.http
from nox.http import HttpError

MAX_REMOTE_RESPONSE_SIZE: int = 65536 # 64 KiB ceiling

class HttpResponse:
    status_code: int
    headers: dict[str, str]
    body: str
    is_redirect: bool
    redirect_location: str

    def __init__(self: HttpResponse, status_code: int, headers: dict[str, str], body: str, is_redirect: bool, redirect_location: str) -> None:
        self.status_code = status_code
        self.headers = headers
        self.body = body
        self.is_redirect = is_redirect
        self.redirect_location = redirect_location

class HttpTransport:
    transport_name: str

    def __init__(self: HttpTransport, name: str) -> None:
        self.transport_name = name

    def send_request(self: HttpTransport, method: str, url: str, headers: dict[str, str], body: str, timeout_ms: int) -> HttpResponse:
        empty_h: dict[str, str] = {}
        return HttpResponse(500, empty_h, "base transport unimplemented", False, "")

class StandardHttpTransport(HttpTransport):
    def __init__(self: StandardHttpTransport) -> None:
        self.transport_name = "standard_nox_http"

    def send_request(self: StandardHttpTransport, method: str, url: str, headers: dict[str, str], body: str, timeout_ms: int) -> HttpResponse:
        try:
            res: nox.http.HttpResponse = nox.http.request(method, url, body, headers, timeout_ms)
            is_redir: bool = res.status == 301 or res.status == 302 or res.status == 307 or res.status == 308
            redir_loc: str = ""
            if is_redir:
                if "Location" in res.headers:
                    redir_loc = res.headers["Location"]
                elif "location" in res.headers:
                    redir_loc = res.headers["location"]

            return HttpResponse(res.status, res.headers, res.body, is_redir, redir_loc)
        except HttpError as err:
            raise ConfigError(ERR_CONFIG_PROVIDER_UNAVAILABLE, url, "http network or timeout error")
        except Exception:
            raise ConfigError(ERR_CONFIG_PROVIDER_UNAVAILABLE, url, "unexpected http transport error")

class MockHttpTransport(HttpTransport):
    routes: dict[str, HttpResponse]
    call_count: int
    should_timeout: bool

    def __init__(self: MockHttpTransport) -> None:
        self.transport_name = "mock"
        self.routes = {}
        self.call_count = 0
        self.should_timeout = False

    def add_route(self: MockHttpTransport, url: str, status_code: int, body: str, redirect_location: str) -> None:
        is_redir: bool = status_code == 301 or status_code == 302 or status_code == 307 or status_code == 308
        h: dict[str, str] = {}
        if is_redir:
            h["Location"] = redirect_location
        self.routes[url] = HttpResponse(status_code, h, body, is_redir, redirect_location)

    def set_timeout(self: MockHttpTransport, timeout: bool) -> None:
        self.should_timeout = timeout

    def send_request(self: MockHttpTransport, method: str, url: str, headers: dict[str, str], body: str, timeout_ms: int) -> HttpResponse:
        self.call_count = self.call_count + 1
        if self.should_timeout:
            raise ConfigError(ERR_CONFIG_PROVIDER_UNAVAILABLE, url, "transport read timeout")

        if url in self.routes:
            return self.routes[url]

        empty_h: dict[str, str] = {}
        return HttpResponse(404, empty_h, "route not found", False, "")

def _extract_authority(https_url: str) -> str:
    # URL is verified to start with https:// (len 8)
    without_scheme: str = https_url[8:len(https_url)]
    # Stop at '/', '?', or '#'
    end_idx: int = len(without_scheme)
    s_idx: int = nox.strings.index_of(without_scheme, "/")
    if s_idx >= 0 and s_idx < end_idx:
        end_idx = s_idx
    q_idx: int = nox.strings.index_of(without_scheme, "?")
    if q_idx >= 0 and q_idx < end_idx:
        end_idx = q_idx
    h_idx: int = nox.strings.index_of(without_scheme, "#")
    if h_idx >= 0 and h_idx < end_idx:
        end_idx = h_idx

    return without_scheme[0:end_idx]

def validate_https_endpoint(url: str, allowlist: list[str]) -> bool:
    # 1. Scheme check: HTTPS only
    if not nox.strings.starts_with(url, "https://"):
        return False

    authority: str = _extract_authority(url)

    # 2. Strict Userinfo / Credential Rejection (RFC 3986 & SSRF protection)
    # Reject '@' in authority to prevent userinfo spoofing (e.g. https://allowed.com:pass@evil.com/)
    if nox.strings.contains(authority, "@"):
        return False

    # 3. Reject URL-encoded characters in authority to prevent hostname obfuscation (NET-02)
    if nox.strings.contains(authority, "%"):
        return False

    # 4. Parse host and optional port, accounting for bracketed IPv6 notation
    host: str = authority
    port: str = ""
    if nox.strings.starts_with(authority, "["):
        r_bracket: int = nox.strings.index_of(authority, "]")
        if r_bracket < 0:
            return False
        host = authority[0:r_bracket + 1]
        if len(authority) > r_bracket + 1:
            after_bracket: str = authority[r_bracket + 1:len(authority)]
            if nox.strings.starts_with(after_bracket, ":"):
                port = after_bracket[1:len(after_bracket)]
    else:
        colon_idx: int = nox.strings.index_of(authority, ":")
        if colon_idx >= 0:
            host = authority[0:colon_idx]
            port = authority[colon_idx + 1:len(authority)]

    # 5. SSRF checks: Rejection of private/unroutable addresses, loopbacks, and cloud metadata (NET-02)
    # A. Loopback addresses (all 127.0.0.0/8 variants and localhost)
    if nox.strings.starts_with(host, "127."):
        return False
    if host == "localhost" or nox.strings.ends_with(host, ".localhost"):
        return False

    # B. Unroutable / broadcast
    if host == "0.0.0.0" or host == "255.255.255.255":
        return False

    # C. Cloud link-local metadata (AWS/GCP/Azure)
    if nox.strings.starts_with(host, "169.254."):
        return False

    # D. RFC 1918 Private IPv4 ranges
    if nox.strings.starts_with(host, "10."):
        return False
    if nox.strings.starts_with(host, "192.168."):
        return False
    if nox.strings.starts_with(host, "172."):
        s_idx: int = 16
        while s_idx <= 31:
            if nox.strings.starts_with(host, "172." + str(s_idx) + "."):
                return False
            s_idx = s_idx + 1

    # E. IPv6 loopback, link-local, unique local, and IPv4-mapped
    if host == "::1" or host == "[::1]" or host == "[0:0:0:0:0:0:0:1]":
        return False
    if nox.strings.starts_with(host, "[fe80:") or nox.strings.starts_with(host, "fe80:"):
        return False
    if nox.strings.starts_with(host, "[fc00:") or nox.strings.starts_with(host, "fc00:"):
        return False
    if nox.strings.starts_with(host, "[fd00:") or nox.strings.starts_with(host, "fd00:"):
        return False
    if nox.strings.starts_with(host, "[::ffff:") or nox.strings.starts_with(host, "::ffff:"):
        return False

    # 6. Allowlist membership check (exact host or exact authority match)
    matched: bool = False
    idx: int = 0
    while idx < len(allowlist):
        allowed: str = allowlist[idx]
        if host == allowed or authority == allowed:
            matched = True
        idx = idx + 1

    return matched

def _validate_secret_key_path(key: str) -> None:
    if len(key) == 0:
        raise ConfigError(ERR_CONFIG_PROVIDER_UNAVAILABLE, key, "empty secret key not permitted in remote endpoint")
    if nox.strings.contains(key, "/") or nox.strings.contains(key, "\\"):
        raise ConfigError(ERR_CONFIG_PROVIDER_UNAVAILABLE, key, "remote secret key cannot contain path traversal or separator characters")
    if nox.strings.contains(key, ".."):
        raise ConfigError(ERR_CONFIG_PROVIDER_UNAVAILABLE, key, "remote secret key cannot contain directory traversal elements")
    if nox.strings.contains(key, "?") or nox.strings.contains(key, "#"):
        raise ConfigError(ERR_CONFIG_PROVIDER_UNAVAILABLE, key, "remote secret key cannot contain query or fragment delimiters")
    if nox.strings.contains(key, " ") or nox.strings.contains(key, "\t"):
        raise ConfigError(ERR_CONFIG_PROVIDER_UNAVAILABLE, key, "remote secret key cannot contain whitespace")
    if nox.strings.contains(key, "%"):
        raise ConfigError(ERR_CONFIG_PROVIDER_UNAVAILABLE, key, "remote secret key cannot contain URL-encoded sequences")
    if nox.strings.contains(key, "\0"):
        raise ConfigError(ERR_CONFIG_PROVIDER_UNAVAILABLE, key, "remote secret key cannot contain null bytes")

class RemoteHttpSecretProvider(SecretProvider):
    base_url: str
    allowed_hosts: list[str]
    auth_header_name: str
    auth_token: str
    timeout_ms: int
    max_retries: int
    transport: HttpTransport

    def __init__(self: RemoteHttpSecretProvider, id: str, base_url: str, allowed_hosts: list[str], auth_header_name: str, auth_token: str, transport: HttpTransport | None) -> None:
        self.id = id
        self.provider_kind = "remote_http"
        self.base_url = base_url
        self.allowed_hosts = allowed_hosts
        self.auth_header_name = auth_header_name
        self.auth_token = auth_token
        self.timeout_ms = 5000
        self.max_retries = 3

        if transport is not None:
            self.transport = transport
        else:
            self.transport = StandardHttpTransport()

        # Initial SSRF / allowlist check
        if not validate_https_endpoint(base_url, allowed_hosts):
            raise ConfigError(ERR_CONFIG_PROVIDER_UNAVAILABLE, id, "endpoint is not an allowed HTTPS target or violates SSRF protection")

    def get(self: RemoteHttpSecretProvider, key: str) -> SecretFetchResult:
        try:
            _validate_secret_key_path(key)
        except ConfigError as err:
            return make_fetch_error(err.code, err.message, self.id)

        current_url: str = self.base_url + "/" + key
        headers: dict[str, str] = {}
        headers[self.auth_header_name] = self.auth_token
        headers["Accept"] = "application/json"

        attempts: int = 0
        while attempts < self.max_retries:
            attempts = attempts + 1
            try:
                resp: HttpResponse = self.transport.send_request("GET", current_url, headers, "", self.timeout_ms)

                # 1. Handle HTTP Redirects (PROVIDER-02): Validate new location before sending credentials
                if resp.is_redirect:
                    redir_target: str = resp.redirect_location
                    if not validate_https_endpoint(redir_target, self.allowed_hosts):
                        return make_fetch_error(ERR_CONFIG_PROVIDER_UNAVAILABLE, "redirect to unapproved or non-HTTPS endpoint blocked", self.id)
                    current_url = redir_target
                    # Continue loop to follow approved redirect
                elif resp.status_code == 200:
                    # 2. Successful response: enforce response size ceiling (64 KiB in actual bytes)
                    if nox.strings.byte_len(resp.body) > MAX_REMOTE_RESPONSE_SIZE:
                        return make_fetch_error(ERR_CONFIG_SIZE_LIMIT, "remote secret response exceeds 64 KiB ceiling", self.id)
                    clean_secret: str = nox.strings.trim(resp.body)
                    return make_fetch_success(clean_secret, key, self.id)
                elif resp.status_code == 401 or resp.status_code == 403:
                    # 3. Auth error: Never leak the auth token in error output!
                    return make_fetch_error(ERR_CONFIG_SECRET_SOURCE_DENIED, "remote provider authentication rejected", self.id)
                elif resp.status_code == 404:
                    # 4. Absent secret
                    return make_fetch_not_found(self.id)
                else:
                    # Server error (5xx): retry if attempts remain
                    pass

            except ConfigError as err:
                if attempts >= self.max_retries:
                    return make_fetch_error(ERR_CONFIG_PROVIDER_UNAVAILABLE, "remote provider timeout or network failure", self.id)
            except Exception:
                if attempts >= self.max_retries:
                    return make_fetch_error(ERR_CONFIG_PROVIDER_UNAVAILABLE, "remote provider request failed", self.id)

        # Retries exhausted (PROVIDER-03)
        return make_fetch_error(ERR_CONFIG_PROVIDER_UNAVAILABLE, "remote provider retries exhausted", self.id)

    def health(self: RemoteHttpSecretProvider) -> ProviderHealth:
        if not validate_https_endpoint(self.base_url, self.allowed_hosts):
            return ProviderHealth(False, "configured endpoint violates allowlist or SSRF policy")
        return ProviderHealth(True, "remote provider configuration healthy")

    def close(self: RemoteHttpSecretProvider) -> None:
        self.auth_token = ""

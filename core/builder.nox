# VAULT — Configuration Builder
# Module: core.builder

from core.types import ConfigEntry, ConfigValue, PRESENCE_MISSING, PRESENCE_NULL, PRESENCE_EMPTY, make_string
from core.errors import ConfigError, ERR_CONFIG_MISSING, ERR_CONFIG_PARSE_ERROR, ERR_CONFIG_SECRET_SOURCE_DENIED, ERR_CONFIG_EMPTY_NOT_ALLOWED
from core.merge import merge_sources
from core.snapshot import ConfigSnapshot
from sources.interface import ConfigSource
from sources.memory import MemorySource
from sources.json import JsonSource
from sources.toml import TomlSource
from sources.yaml import YamlSource
from env.source import DotenvSource
from env.process import ProcessEnvSource
from schema.fields import ConfigSchema, Field
from schema.validate import validate_entries, ValidationReport, SafeConfigDiagnostic, populate_schema_defaults
from profiles.overlay import validate_profile_name, is_production_profile, profile_filename
from interpolate.resolve import resolve_interpolations
from providers.interface import SecretProvider
from providers.source import SecretProviderSource

class ConfigBuilder:
    sources: list[ConfigSource]
    schema: ConfigSchema | None
    is_production: bool
    builder_version: str
    allowed_root: str
    profile: str
    allowed_profiles: list[str]

    def __init__(self: ConfigBuilder) -> None:
        self.sources = []
        self.schema = None
        self.is_production = False
        self.builder_version = "v1"
        self.allowed_root = ""
        self.profile = "development"
        self.allowed_profiles = ["development", "dev", "test", "staging", "production", "prod"]

    def with_allowed_root(self: ConfigBuilder, root: str) -> ConfigBuilder:
        self.allowed_root = root
        # Propagate allowed_root retroactively to any sources added prior to this call (CONF-01)
        s_idx: int = 0
        while s_idx < len(self.sources):
            self.sources[s_idx].set_allowed_root(root)
            s_idx = s_idx + 1
        return self

    def with_profile(self: ConfigBuilder, name: str) -> ConfigBuilder:
        cleaned: str = validate_profile_name(name)
        if len(self.allowed_profiles) > 0:
            found: bool = False
            idx: int = 0
            while idx < len(self.allowed_profiles):
                if self.allowed_profiles[idx] == cleaned:
                    found = True
                idx = idx + 1
            if not found:
                raise ConfigError(ERR_CONFIG_PARSE_ERROR, cleaned, "unknown profile: '" + cleaned + "' is not recognized")
        self.profile = cleaned
        if is_production_profile(cleaned):
            self.is_production = True
        return self

    def allow_profile(self: ConfigBuilder, name: str) -> ConfigBuilder:
        cleaned: str = validate_profile_name(name)
        self.allowed_profiles.append(cleaned)
        return self

    def with_source(self: ConfigBuilder, src: ConfigSource) -> ConfigBuilder:
        self.sources.append(src)
        return self

    def with_defaults(self: ConfigBuilder, defaults: dict[str, str]) -> ConfigBuilder:
        ms: MemorySource = MemorySource("memory_defaults", 2, "base", True)
        d_keys: list[str] = defaults.keys()
        d_idx: int = 0
        while d_idx < len(d_keys):
            k: str = d_keys[d_idx]
            ms.set_string(k, defaults[k])
            d_idx = d_idx + 1
        self.sources.append(ms)
        return self

    def with_json_file(self: ConfigBuilder, path: str, optional: bool) -> ConfigBuilder:
        js: JsonSource = JsonSource(path, self.allowed_root, optional, 3, "base")
        self.sources.append(js)
        return self

    def with_toml_file(self: ConfigBuilder, path: str, optional: bool) -> ConfigBuilder:
        ts: TomlSource = TomlSource(path, self.allowed_root, optional, 3, "base")
        self.sources.append(ts)
        return self

    def with_yaml_file(self: ConfigBuilder, path: str, optional: bool) -> ConfigBuilder:
        ys: YamlSource = YamlSource(path, self.allowed_root, optional, 3, "base")
        self.sources.append(ys)
        return self

    def with_file(self: ConfigBuilder, path: str, format_name: str, optional: bool) -> ConfigBuilder:
        if format_name == "json":
            return self.with_json_file(path, optional)
        if format_name == "toml":
            return self.with_toml_file(path, optional)
        if format_name == "yaml" or format_name == "yml":
            return self.with_yaml_file(path, optional)
        return self

    def with_profile_file(self: ConfigBuilder, base_path: str, format_name: str, optional: bool) -> ConfigBuilder:
        p_path: str = profile_filename(base_path, self.profile)
        if format_name == "json":
            self.sources.append(JsonSource(p_path, self.allowed_root, optional, 4, self.profile))
        elif format_name == "toml":
            self.sources.append(TomlSource(p_path, self.allowed_root, optional, 4, self.profile))
        elif format_name == "yaml" or format_name == "yml":
            self.sources.append(YamlSource(p_path, self.allowed_root, optional, 4, self.profile))
        return self

    def with_dotenv(self: ConfigBuilder, path: str, optional: bool) -> ConfigBuilder:
        ds: DotenvSource = DotenvSource(path, self.allowed_root, optional, 5, "base")
        self.sources.append(ds)
        return self

    def with_profile_dotenv(self: ConfigBuilder, base_path: str, optional: bool) -> ConfigBuilder:
        p_path: str = profile_filename(base_path, self.profile)
        ds: DotenvSource = DotenvSource(p_path, self.allowed_root, optional, 6, self.profile)
        self.sources.append(ds)
        return self

    def with_secret_provider(self: ConfigBuilder, provider: SecretProvider, keys: list[str], fail_closed: bool) -> ConfigBuilder:
        src: SecretProviderSource = SecretProviderSource(provider, keys, 7, self.profile, fail_closed)
        self.sources.append(src)
        return self

    def with_process_env(self: ConfigBuilder, allowed_keys: list[str], mapping: dict[str, str]) -> ConfigBuilder:
        ps: ProcessEnvSource = ProcessEnvSource(allowed_keys, mapping, 8, "base")
        self.sources.append(ps)
        return self

    def with_override(self: ConfigBuilder, key: str, val: str) -> ConfigBuilder:
        ov: MemorySource = MemorySource("runtime_override", 9, "base", False)
        ov.set_string(key, val)
        self.sources.append(ov)
        return self

    def with_schema(self: ConfigBuilder, schema: ConfigSchema) -> ConfigBuilder:
        self.schema = schema
        return self

    def set_production(self: ConfigBuilder, is_prod: bool) -> ConfigBuilder:
        self.is_production = is_prod
        return self

    def build(self: ConfigBuilder) -> ConfigSnapshot:
        # Step 0: Ensure all sources have the final allowed_root configuration (CONF-01)
        if len(self.allowed_root) > 0:
            root_idx: int = 0
            while root_idx < len(self.sources):
                self.sources[root_idx].set_allowed_root(self.allowed_root)
                root_idx = root_idx + 1

        # Step 1: Merge sources deterministically
        merged: dict[str, ConfigEntry] = merge_sources(self.sources)

        # Step 2: Populate schema defaults and mark declared secrets before interpolation (ORD-01)
        schema_opt: ConfigSchema | None = self.schema
        if schema_opt is not None:
            populate_schema_defaults(merged, schema_opt)

        # Step 3: Resolve interpolations (with cycle detection, depth limits, and taint propagation)
        resolved: dict[str, ConfigEntry] = resolve_interpolations(merged)

        # Step 4: Validate against schema (validates all values, including defaults and constraints) (VAL-01)
        if schema_opt is not None:
            report: ValidationReport = validate_entries(resolved, schema_opt, self.is_production)
            if not report.is_valid:
                first_err: SafeConfigDiagnostic = report.diagnostics[0]
                total_errors: int = report.error_count()
                summary_msg: str = first_err.message + " (" + str(total_errors) + " total validation errors)"
                raise ConfigError(first_err.code, first_err.key, summary_msg)

        # Step 5: Production safety checks (PROFILE-01)
        if self.is_production:
            res_keys: list[str] = resolved.keys()
            p_idx: int = 0
            while p_idx < len(res_keys):
                k: str = res_keys[p_idx]
                ent: ConfigEntry = resolved[k]
                if ent.is_secret:
                    if ent.is_default:
                        raise ConfigError(ERR_CONFIG_SECRET_SOURCE_DENIED, k, "secret cannot use default value in production")
                    if ent.presence == PRESENCE_MISSING or ent.presence == PRESENCE_NULL:
                        raise ConfigError(ERR_CONFIG_MISSING, k, "required secret is missing in production")
                    if ent.presence == PRESENCE_EMPTY:
                        raise ConfigError(ERR_CONFIG_EMPTY_NOT_ALLOWED, k, "secret cannot be empty in production")
                p_idx = p_idx + 1

        return ConfigSnapshot(resolved, self.builder_version)

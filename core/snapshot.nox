# VAULT — Immutable Config Snapshot
# Module: core.snapshot

from core.types import ConfigEntry, ConfigValue, VAL_STRING, VAL_INTEGER, VAL_FLOAT, VAL_BOOLEAN, VAL_ARRAY, PRESENCE_NULL, PRESENCE_MISSING, clone_config_entry
from core.errors import ConfigError, ERR_CONFIG_MISSING, ERR_CONFIG_NULL_NOT_ALLOWED, ERR_CONFIG_TYPE_MISMATCH, ERR_CONFIG_SECRET_SOURCE_DENIED
from secrets.mark import SecretValue
from secrets.reveal import reveal_secret_entry, create_secret_value
from secrets.redact import to_redacted_json
import nox.strings

class ConfigSnapshot:
    entries: dict[str, ConfigEntry]
    snapshot_version: str

    def __init__(self: ConfigSnapshot, entries: dict[str, ConfigEntry], version: str) -> None:
        # Deep defensive copy to guarantee snapshot immutability against external mutation
        defensive_copy: dict[str, ConfigEntry] = {}
        all_keys: list[str] = entries.keys()
        idx: int = 0
        while idx < len(all_keys):
            k: str = all_keys[idx]
            defensive_copy[k] = clone_config_entry(entries[k])
            idx = idx + 1

        self.entries = defensive_copy
        self.snapshot_version = version

    def has(self: ConfigSnapshot, key: str) -> bool:
        return key in self.entries

    def is_null(self: ConfigSnapshot, key: str) -> bool:
        if key not in self.entries:
            return False
        return self.entries[key].presence == PRESENCE_NULL

    def is_secret(self: ConfigSnapshot, key: str) -> bool:
        if key not in self.entries:
            return False
        return self.entries[key].is_secret

    def keys(self: ConfigSnapshot) -> list[str]:
        return self.entries.keys()

    def get_entry(self: ConfigSnapshot, key: str) -> ConfigEntry:
        # Returns a defensive clone of ConfigEntry to protect snapshot immutability (IMMUT-02)
        if key not in self.entries:
            raise ConfigError(ERR_CONFIG_MISSING, key, "configuration key is missing")
        return clone_config_entry(self.entries[key])

    def clone(self: ConfigSnapshot) -> ConfigSnapshot:
        return ConfigSnapshot(self.entries, self.snapshot_version)

    def get_string(self: ConfigSnapshot, key: str) -> str:
        if key not in self.entries:
            raise ConfigError(ERR_CONFIG_MISSING, key, "configuration key is missing")

        e: ConfigEntry = self.entries[key]
        if e.is_secret:
            raise ConfigError(ERR_CONFIG_SECRET_SOURCE_DENIED, key, "key is classified as a secret: call get_secret() or get_secret_value() for explicit intentional access")

        if e.presence == PRESENCE_NULL:
            raise ConfigError(ERR_CONFIG_NULL_NOT_ALLOWED, key, "configuration key is null")

        v: ConfigValue = e.val
        if v.kind == VAL_STRING:
            return v.s
        if v.kind == VAL_INTEGER:
            return str(v.i)
        if v.kind == VAL_BOOLEAN:
            if v.b:
                return "true"
            return "false"
        if v.kind == VAL_FLOAT:
            return str(v.f)

        raise ConfigError(ERR_CONFIG_TYPE_MISMATCH, key, "cannot convert structured container to string")

    def get_int(self: ConfigSnapshot, key: str) -> int:
        if key not in self.entries:
            raise ConfigError(ERR_CONFIG_MISSING, key, "configuration key is missing")

        e: ConfigEntry = self.entries[key]
        if e.is_secret:
            raise ConfigError(ERR_CONFIG_SECRET_SOURCE_DENIED, key, "key is classified as a secret: call get_secret() or get_secret_value() for explicit intentional access")

        if e.presence == PRESENCE_NULL:
            raise ConfigError(ERR_CONFIG_NULL_NOT_ALLOWED, key, "configuration key is null")

        v: ConfigValue = e.val
        if v.kind == VAL_INTEGER:
            return v.i
        if v.kind == VAL_STRING:
            trimmed: str = nox.strings.trim(v.s)
            try:
                return int(trimmed)
            except Exception:
                raise ConfigError(ERR_CONFIG_TYPE_MISMATCH, key, "cannot convert string to integer")

        raise ConfigError(ERR_CONFIG_TYPE_MISMATCH, key, "expected integer value")

    def get_float(self: ConfigSnapshot, key: str) -> float:
        if key not in self.entries:
            raise ConfigError(ERR_CONFIG_MISSING, key, "configuration key is missing")

        e: ConfigEntry = self.entries[key]
        if e.is_secret:
            raise ConfigError(ERR_CONFIG_SECRET_SOURCE_DENIED, key, "key is classified as a secret: call get_secret() or get_secret_value() for explicit intentional access")

        if e.presence == PRESENCE_NULL:
            raise ConfigError(ERR_CONFIG_NULL_NOT_ALLOWED, key, "configuration key is null")

        v: ConfigValue = e.val
        if v.kind == VAL_FLOAT:
            return v.f
        if v.kind == VAL_INTEGER:
            return float(v.i)
        if v.kind == VAL_STRING:
            trimmed: str = nox.strings.trim(v.s)
            try:
                return float(trimmed)
            except Exception:
                raise ConfigError(ERR_CONFIG_TYPE_MISMATCH, key, "cannot convert string to float")

        raise ConfigError(ERR_CONFIG_TYPE_MISMATCH, key, "expected float value")

    def get_bool(self: ConfigSnapshot, key: str) -> bool:
        if key not in self.entries:
            raise ConfigError(ERR_CONFIG_MISSING, key, "configuration key is missing")

        e: ConfigEntry = self.entries[key]
        if e.is_secret:
            raise ConfigError(ERR_CONFIG_SECRET_SOURCE_DENIED, key, "key is classified as a secret: call get_secret() or get_secret_value() for explicit intentional access")

        if e.presence == PRESENCE_NULL:
            raise ConfigError(ERR_CONFIG_NULL_NOT_ALLOWED, key, "configuration key is null")

        v: ConfigValue = e.val
        if v.kind == VAL_BOOLEAN:
            return v.b
        if v.kind == VAL_INTEGER:
            if v.i == 1:
                return True
            if v.i == 0:
                return False
            raise ConfigError(ERR_CONFIG_TYPE_MISMATCH, key, "integer boolean must be 0 or 1")
        if v.kind == VAL_STRING:
            low: str = nox.strings.lower(nox.strings.trim(v.s))
            if low == "true" or low == "1" or low == "yes" or low == "on":
                return True
            if low == "false" or low == "0" or low == "no" or low == "off":
                return False
            raise ConfigError(ERR_CONFIG_TYPE_MISMATCH, key, "invalid boolean representation")

        raise ConfigError(ERR_CONFIG_TYPE_MISMATCH, key, "expected boolean value")

    def get_list(self: ConfigSnapshot, key: str) -> list[str]:
        if key not in self.entries:
            raise ConfigError(ERR_CONFIG_MISSING, key, "configuration key is missing")

        e: ConfigEntry = self.entries[key]
        if e.is_secret:
            raise ConfigError(ERR_CONFIG_SECRET_SOURCE_DENIED, key, "key is classified as a secret: call get_secret() or get_secret_value() for explicit intentional access")

        if e.presence == PRESENCE_NULL:
            raise ConfigError(ERR_CONFIG_NULL_NOT_ALLOWED, key, "configuration key is null")

        v: ConfigValue = e.val
        if v.kind == VAL_ARRAY:
            res: list[str] = []
            idx: int = 0
            while idx < len(v.arr):
                item: ConfigValue = v.arr[idx]
                if item.kind == VAL_STRING:
                    res.append(item.s)
                else:
                    res.append(str(item.i) if item.kind == VAL_INTEGER else "")
                idx = idx + 1
            return res
        if v.kind == VAL_STRING:
            trimmed: str = nox.strings.trim(v.s)
            if len(trimmed) == 0:
                empty_res: list[str] = []
                return empty_res
            parts: list[str] = nox.strings.split(trimmed, ",")
            res: list[str] = []
            idx: int = 0
            while idx < len(parts):
                res.append(nox.strings.trim(parts[idx]))
                idx = idx + 1
            return res

        raise ConfigError(ERR_CONFIG_TYPE_MISMATCH, key, "expected list value")

    def explain(self: ConfigSnapshot, key: str) -> str:
        if key not in self.entries:
            return "key='" + key + "': missing (not present in any source)"

        e: ConfigEntry = self.entries[key]
        secret_str: str = "false"
        if e.is_secret:
            secret_str = "true"

        # Notice: value is NEVER included in explain!
        return "key='" + key + "', presence=" + str(e.presence) + ", source_kind=" + e.origin.source_kind + ", source_id='" + e.origin.source_id + "', profile=" + e.origin.profile + ", rank=" + str(e.origin.precedence_rank) + ", is_secret=" + secret_str

    def get_secret(self: ConfigSnapshot, key: str) -> str:
        if key not in self.entries:
            raise ConfigError(ERR_CONFIG_MISSING, key, "configuration secret is missing")
        return reveal_secret_entry(self.entries[key])

    def get_secret_value(self: ConfigSnapshot, key: str) -> SecretValue:
        if key not in self.entries:
            raise ConfigError(ERR_CONFIG_MISSING, key, "configuration secret is missing")
        return create_secret_value(self.entries[key])

    def describe(self: ConfigSnapshot, key: str) -> str:
        return self.explain(key)

    def redacted_json(self: ConfigSnapshot) -> str:
        return to_redacted_json(self.entries)

    def version(self: ConfigSnapshot) -> str:
        return self.snapshot_version

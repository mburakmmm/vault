# VAULT — Performance & Scale Benchmark (PERF-01)
# Verifies 1000+ key configuration load across multiple sources (dotenv, json, memory),
# 3-level chained variable interpolation, schema validation, and sub-second execution.

from nox.test import assert_true, assert_eq_str, assert_eq_int
from nox.fs import write_string, remove_file, exists
import nox.time
from vault import ConfigBuilder, ConfigSchema, ConfigSnapshot
from reload.manager import ReloadManager, PublishedConfig
from sources.memory import MemorySource

def test_large_scale_benchmark_1000_keys() -> None:
    # 1. Setup paths
    env_file: str = "fixtures/benchmark_temp.env"
    json_file: str = "fixtures/benchmark_temp.json"

    # 2. Generate Dotenv with 400 keys
    env_lines: list[str] = []
    e_idx: int = 0
    while e_idx < 400:
        env_lines.append("BENCH_DOTENV_" + str(e_idx) + "=val_dotenv_" + str(e_idx) + "\n")
        e_idx = e_idx + 1

    env_body: str = ""
    e_idx = 0
    while e_idx < len(env_lines):
        env_body = env_body + env_lines[e_idx]
        e_idx = e_idx + 1
    write_string(env_file, env_body)

    # 3. Generate JSON with 300 keys
    json_parts: list[str] = []
    json_parts.append("{\n")
    j_idx: int = 0
    while j_idx < 300:
        comma: str = "," if j_idx < 299 else ""
        json_parts.append('  "bench_json_' + str(j_idx) + '": "val_json_' + str(j_idx) + '"' + comma + '\n')
        j_idx = j_idx + 1
    json_parts.append("}\n")

    json_body: str = ""
    j_idx = 0
    while j_idx < len(json_parts):
        json_body = json_body + json_parts[j_idx]
        j_idx = j_idx + 1
    write_string(json_file, json_body)

    # 4. Generate Memory Source with 300 keys including 3-level chained interpolation
    mem_src: MemorySource = MemorySource("bench_memory", 2, "base", False)
    m_idx: int = 0
    while m_idx < 296:
        mem_src.set_string("MEM_BENCH_" + str(m_idx), "val_mem_" + str(m_idx))
        m_idx = m_idx + 1

    # 3-level chained interpolation
    mem_src.set_string("CHAIN_ROOT", "root")
    mem_src.set_string("CHAIN_L1", "${CHAIN_ROOT}_level1")
    mem_src.set_string("CHAIN_L2", "${CHAIN_L1}_level2")
    mem_src.set_string("APP_CHAIN_FINAL", "${CHAIN_L2}_level3")

    # 5. Schema validation definitions
    schema: ConfigSchema = ConfigSchema()
    schema.add_string("APP_CHAIN_FINAL", True, False, "", False, True)
    schema.add_string("BENCH_DOTENV_0", True, False, "", False, True)
    schema.add_string("bench_json_0", True, False, "", False, True)
    schema.add_string("MEM_BENCH_100", True, False, "", False, True)

    # 6. Run Benchmark and measure time
    t_start: int = nox.time.now_ms()

    builder: ConfigBuilder = ConfigBuilder()
    builder.with_source(mem_src)
    builder.with_json_file(json_file, False)
    builder.with_dotenv(env_file, False)
    builder.with_schema(schema)

    snapshot: ConfigSnapshot = builder.build()
    t_elapsed: int = nox.time.now_ms() - t_start

    # Clean up generated fixture files
    if exists(env_file):
        remove_file(env_file)
    if exists(json_file):
        remove_file(json_file)

    # 7. Assertions
    # A. Key count >= 1000
    total_keys: int = len(snapshot.keys())
    assert_true(total_keys >= 1000, "Snapshot must contain at least 1000 keys, actual: " + str(total_keys))

    # B. 3-level chained interpolation resolved correctly
    assert_eq_str(snapshot.get_string("APP_CHAIN_FINAL"), "root_level1_level2_level3", "3-level chained interpolation must resolve")

    # C. Source values preserved across memory, dotenv, and json
    assert_eq_str(snapshot.get_string("BENCH_DOTENV_0"), "val_dotenv_0", "dotenv key preserved")
    assert_eq_str(snapshot.get_string("bench_json_0"), "val_json_0", "json key preserved")
    assert_eq_str(snapshot.get_string("MEM_BENCH_100"), "val_mem_100", "memory key preserved")

    # D. Performance: Must finish well under 1500 ms
    print("Benchmark completed in " + str(t_elapsed) + " ms for " + str(total_keys) + " keys")
    assert_true(t_elapsed < 1500, "1000-key build + interpolation + validation must finish within 1500ms, took " + str(t_elapsed) + " ms")

test_large_scale_benchmark_1000_keys()
print("PASS: test_large_scale_benchmark_1000_keys")

def test_large_scale_schema_benchmark_1000_fields() -> None:
    # TEST-01: Benchmark validating 1,000 declared schema fields with constraints
    schema: ConfigSchema = ConfigSchema()
    mem_src: MemorySource = MemorySource("schema_bench_mem", 2, "base", False)

    # 1. 500 string fields
    s_idx: int = 0
    while s_idx < 500:
        k: str = "FIELD_STR_" + str(s_idx)
        mem_src.set_string(k, "string_value_" + str(s_idx))
        schema.add_string(k, True, False, "", False, True)
        s_idx = s_idx + 1

    # 2. 300 integer fields with range bounds (1 to 100000)
    i_idx: int = 0
    while i_idx < 300:
        k_i: str = "FIELD_INT_" + str(i_idx)
        val_i: int = i_idx + 10
        mem_src.set_string(k_i, str(val_i))
        schema.add_int(k_i, True, False, 0, True, 1, True, 100000, False)
        i_idx = i_idx + 1

    # 3. 200 boolean fields
    b_idx: int = 0
    while b_idx < 200:
        k_b: str = "FIELD_BOOL_" + str(b_idx)
        bool_str: str = "true" if b_idx % 2 == 0 else "false"
        mem_src.set_string(k_b, bool_str)
        schema.add_bool(k_b, True, False, False, False)
        b_idx = b_idx + 1

    # 4. Measure time taken for 1000-field schema validation
    t_start: int = nox.time.now_ms()

    builder: ConfigBuilder = ConfigBuilder()
    builder.with_source(mem_src)
    builder.with_schema(schema)

    snap: ConfigSnapshot = builder.build()
    t_elapsed: int = nox.time.now_ms() - t_start

    print("1,000-field Schema Benchmark completed in " + str(t_elapsed) + " ms")

    # 5. Assertions
    assert_true(len(snap.keys()) == 1000, "1000 keys must be present in snapshot")
    assert_eq_str(snap.get_string("FIELD_STR_499"), "string_value_499", "string field validated")
    assert_eq_int(snap.get_int("FIELD_INT_299"), 309, "int field coerced and range-validated")
    assert_true(snap.get_bool("FIELD_BOOL_0"), "bool field coerced to true")
    assert_true(not snap.get_bool("FIELD_BOOL_1"), "bool field coerced to false")
    assert_true(t_elapsed < 1500, "1000-field schema validation must complete within 1500ms, took " + str(t_elapsed) + " ms")

test_large_scale_schema_benchmark_1000_fields()
print("PASS: test_large_scale_schema_benchmark_1000_fields")

def test_statistical_benchmark_multirun() -> None:
    # TEST-02: Multi-run microbenchmark with warm-up (10 runs) collecting min/avg/max telemetry
    # Reusable schema with 200 validated fields
    schema: ConfigSchema = ConfigSchema()
    s_idx: int = 0
    while s_idx < 100:
        schema.add_string("STAT_STR_" + str(s_idx), True, False, "", False, True)
        schema.add_int("STAT_INT_" + str(s_idx), True, False, 0, True, 0, True, 100000, False)
        s_idx = s_idx + 1

    # Reusable memory source with 1,000 keys
    mem_src: MemorySource = MemorySource("stat_bench_mem", 2, "base", False)
    k_idx: int = 0
    while k_idx < 100:
        mem_src.set_string("STAT_STR_" + str(k_idx), "stat_value_" + str(k_idx))
        mem_src.set_string("STAT_INT_" + str(k_idx), str(k_idx * 10))
        k_idx = k_idx + 1
    extra_idx: int = 0
    while extra_idx < 800:
        mem_src.set_string("EXTRA_KEY_" + str(extra_idx), "val_" + str(extra_idx))
        extra_idx = extra_idx + 1

    # Warm-up run (1 iteration, unmeasured)
    warmup_builder: ConfigBuilder = ConfigBuilder()
    warmup_builder.with_source(mem_src)
    warmup_builder.with_schema(schema)
    warmup_snap: ConfigSnapshot = warmup_builder.build()
    assert_true(len(warmup_snap.keys()) == 1000, "Warm-up must produce 1000 keys")

    # PERF-04: Multi-run microbenchmark (50 runs x 5 batches = 250,000 keys) collecting sub-millisecond us/key & p50/p90/p95/p99 percentiles
    runs: int = 50
    batch_per_run: int = 5
    total_ms: int = 0
    times: list[int] = []

    run_idx: int = 0
    while run_idx < runs:
        t0: int = nox.time.now_ms()
        b_idx: int = 0
        while b_idx < batch_per_run:
            b: ConfigBuilder = ConfigBuilder()
            b.with_source(mem_src)
            b.with_schema(schema)
            s: ConfigSnapshot = b.build()
            b_idx = b_idx + 1
        elapsed: int = nox.time.now_ms() - t0

        total_ms = total_ms + elapsed
        times.append(elapsed)
        run_idx = run_idx + 1

    # Sort times to compute exact percentiles
    sort_i: int = 1
    while sort_i < len(times):
        val: int = times[sort_i]
        sort_j: int = sort_i - 1
        while sort_j >= 0 and times[sort_j] > val:
            times[sort_j + 1] = times[sort_j]
            sort_j = sort_j - 1
        times[sort_j + 1] = val
        sort_i = sort_i + 1

    min_ms: int = times[0]
    p50_ms: int = times[25] # 50th percentile (median)
    p90_ms: int = times[45] # 90th percentile
    p95_ms: int = times[47] # 95th percentile
    p99_ms: int = times[49] # 99th percentile
    max_ms: int = times[len(times) - 1]
    avg_ms: int = total_ms // runs

    # Sub-millisecond latency per key operation in exact nanoseconds and float microseconds
    total_keys_per_run: int = batch_per_run * 1000
    p50_ns: int = (p50_ms * 1000000) // total_keys_per_run
    p95_ns: int = (p95_ms * 1000000) // total_keys_per_run
    p99_ns: int = (p99_ms * 1000000) // total_keys_per_run

    p50_us_flt: float = float(p50_ns) / 1000.0
    p95_us_flt: float = float(p95_ns) / 1000.0
    p99_us_flt: float = float(p99_ns) / 1000.0

    print("Statistical Microbenchmark (50 runs x 5 batches x 1000 keys = 250,000 key resolutions): min=" + str(min_ms) + "ms, p50=" + str(p50_ms) + "ms (" + str(p50_ns) + " ns/key | " + str(p50_us_flt) + " us/key), p90=" + str(p90_ms) + "ms, p95=" + str(p95_ms) + "ms (" + str(p95_ns) + " ns/key | " + str(p95_us_flt) + " us/key), p99=" + str(p99_ms) + "ms (" + str(p99_ns) + " ns/key | " + str(p99_us_flt) + " us/key), max=" + str(max_ms) + "ms, avg=" + str(avg_ms) + "ms")
    assert_true(p95_ms < 1000, "p95 latency must be < 1000ms, actual: " + str(p95_ms) + " ms")
    assert_true(avg_ms < 1000, "Statistical average latency must be < 1000ms, actual: " + str(avg_ms) + " ms")

test_statistical_benchmark_multirun()
print("PASS: test_statistical_benchmark_multirun")

# PERF-06: Seqlock Read Latency Benchmark
def test_seqlock_read_benchmark() -> None:
    schema: ConfigSchema = ConfigSchema()
    schema.add_string("APP_NAME", True, True, "SeqlockBench", False, True)
    mem_src: MemorySource = MemorySource("bench_mem", 5, "base", False)
    mem_src.set_string("APP_NAME", "SeqlockBench_v1")

    b: ConfigBuilder = ConfigBuilder()
    b.with_schema(schema)
    b.with_source(mem_src)

    mgr: ReloadManager = ReloadManager(b)

    # 100,000 uncontended seqlock reads
    total_reads: int = 100000
    t0: int = nox.time.now_ms()
    i: int = 0
    while i < total_reads:
        pub: PublishedConfig = mgr.get_published()
        i = i + 1
    t1: int = nox.time.now_ms()
    elapsed_ms: int = t1 - t0
    if elapsed_ms == 0:
        elapsed_ms = 1

    ns_per_read: int = (elapsed_ms * 1000000) // total_reads
    us_per_read: float = float(ns_per_read) / 1000.0
    print("Seqlock Benchmark (100,000 reads): total=" + str(elapsed_ms) + "ms, " + str(ns_per_read) + " ns/read (" + str(us_per_read) + " us/read)")
    assert_true(elapsed_ms < 1000, "100,000 seqlock reads must complete under 1000ms")

test_seqlock_read_benchmark()
print("PASS: test_seqlock_read_benchmark")

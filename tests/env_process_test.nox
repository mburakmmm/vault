# Test suite for Allowlist-Only Process Environment Source
# Regression scenarios: ENV-01, ENV-02

from nox.test import assert_eq_str, assert_eq_int, assert_true
from env.process import ProcessEnvSource
from core.types import ConfigEntry, PRESENCE_SUPPLIED, PRESENCE_EMPTY
from nox.os import set_var

# Setup test environment variables
set_var("VAULT_TEST_PRESENT_KEY", "active_value")
# Note: On Windows, setting an env var to "" deletes it via Win32 API.
set_var("VAULT_TEST_EMPTY_KEY", "")

# Define allowed keys and canonical mappings
allowed: list[str] = []
allowed.append("VAULT_TEST_PRESENT_KEY")
allowed.append("VAULT_TEST_EMPTY_KEY")
allowed.append("VAULT_TEST_MISSING_KEY")

mapping: dict[str, str] = {}
mapping["VAULT_TEST_PRESENT_KEY"] = "app.present"
mapping["VAULT_TEST_EMPTY_KEY"] = "app.empty"
mapping["VAULT_TEST_MISSING_KEY"] = "app.missing"

src: ProcessEnvSource = ProcessEnvSource(allowed, mapping, 8, "base")
entries: list[ConfigEntry] = src.load()

# ENV-01 verification: VAULT_TEST_MISSING_KEY must be absent, not empty string!
missing_found: bool = False
present_found: bool = False
empty_found: bool = False

idx: int = 0
while idx < len(entries):
    e: ConfigEntry = entries[idx]
    if e.key == "app.missing":
        missing_found = True
    elif e.key == "app.present":
        present_found = True
        assert_eq_str(e.val.s, "active_value", "present env value mismatch")
        assert_eq_int(e.presence, PRESENCE_SUPPLIED, "present presence state mismatch")
    elif e.key == "app.empty":
        empty_found = True
        assert_eq_str(e.val.s, "", "empty env value mismatch")
        assert_eq_int(e.presence, PRESENCE_EMPTY, "empty presence state mismatch (ENV-02)")
    idx = idx + 1

assert_true(present_found, "present key must be found")
assert_true(not missing_found, "missing key must NOT be present (ENV-01)")

# If platform supports empty env vars (POSIX), verify it was recorded as PRESENCE_EMPTY
if empty_found:
    print("ENV_PROCESS: Empty env var verified as PRESENCE_EMPTY (ENV-02)")
else:
    print("ENV_PROCESS: Windows Win32 environment semantics confirmed (empty var removed by OS)")

print("ENV_PROCESS_TEST: ALL PASS")

# Test suite for JSON Source
# Regression scenarios: FORMAT-01, FORMAT-02

from nox.test import assert_eq_str, assert_eq_int, assert_true
from sources.json import JsonSource
from core.types import ConfigEntry, VAL_STRING, VAL_INTEGER, VAL_FLOAT, VAL_BOOLEAN, VAL_ARRAY, VAL_OBJECT
from core.errors import ConfigError, ERR_CONFIG_PARSE_ERROR

# -------------------------------------------------------------------------
# Test 1: Valid JSON Loading & Nested Structure (FORMAT-01)
# -------------------------------------------------------------------------
js: JsonSource = JsonSource("fixtures/config/app.json", "fixtures", False, 3, "base")
entries: list[ConfigEntry] = js.load()

entry_map: dict[str, ConfigEntry] = {}
idx: int = 0
while idx < len(entries):
    entry_map[entries[idx].key] = entries[idx]
    idx = idx + 1

# Check string
assert_eq_str(entry_map["service"].val.s, "vault_api", "service name")

# Check int
assert_eq_int(entry_map["port"].val.i, 7070, "port int")

# Check bool
assert_true(entry_map["metrics_enabled"].val.b, "metrics enabled bool")

# Check float
assert_true(entry_map["rate_limit"].val.f > 100.0, "rate limit float")

# Check array
tags_entry: ConfigEntry = entry_map["tags"]
assert_eq_int(tags_entry.val.kind, VAL_ARRAY, "tags array kind")
assert_eq_int(len(tags_entry.val.arr), 2, "tags array len")
assert_eq_str(tags_entry.val.arr[0].s, "prod", "tag 0")
assert_eq_str(tags_entry.val.arr[1].s, "security", "tag 1")

# Check nested object
db_entry: ConfigEntry = entry_map["database"]
assert_eq_int(db_entry.val.kind, VAL_OBJECT, "db object kind")
assert_eq_str(db_entry.val.obj["host"].s, "db.internal", "db host")
assert_eq_int(db_entry.val.obj["port"].i, 5432, "db port")

# -------------------------------------------------------------------------
# Test 2: Invalid JSON Syntax Rejection (FORMAT-02)
# -------------------------------------------------------------------------
js_invalid: JsonSource = JsonSource("fixtures/config/invalid.json", "fixtures", False, 3, "base")
invalid_caught: bool = False
try:
    js_invalid.load()
except ConfigError as e:
    invalid_caught = True
    assert_eq_str(e.code, ERR_CONFIG_PARSE_ERROR, "invalid json error code")
except Exception:
    pass

assert_true(invalid_caught, "invalid json document must raise CONFIG_PARSE_ERROR")

print("JSON_SOURCE_TEST: ALL PASS")

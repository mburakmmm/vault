# Test suite for YAML Source
# Regression scenarios: FORMAT-01

from nox.test import assert_eq_str, assert_eq_int, assert_true
from sources.yaml import YamlSource
from core.types import ConfigEntry, VAL_STRING, VAL_INTEGER, VAL_FLOAT, VAL_BOOLEAN, VAL_ARRAY, VAL_OBJECT

ys: YamlSource = YamlSource("fixtures/config/app.yaml", "fixtures", False, 3, "base")
entries: list[ConfigEntry] = ys.load()

entry_map: dict[str, ConfigEntry] = {}
idx: int = 0
while idx < len(entries):
    entry_map[entries[idx].key] = entries[idx]
    idx = idx + 1

# Check string
assert_eq_str(entry_map["service"].val.s, "vault_yaml_service", "service name")

# Check int
assert_eq_int(entry_map["port"].val.i, 7090, "port int")

# Check bool
assert_true(entry_map["metrics_enabled"].val.b, "metrics enabled bool")

# Check float
assert_true(entry_map["rate_limit"].val.f > 40.0, "rate limit float")

# Check sequence
tags_entry: ConfigEntry = entry_map["tags"]
assert_eq_int(tags_entry.val.kind, VAL_ARRAY, "tags sequence kind")
assert_eq_int(len(tags_entry.val.arr), 2, "tags sequence len")
assert_eq_str(tags_entry.val.arr[0].s, "yaml", "tag 0")
assert_eq_str(tags_entry.val.arr[1].s, "structured", "tag 1")

# Check mapping
db_entry: ConfigEntry = entry_map["database"]
assert_eq_int(db_entry.val.kind, VAL_OBJECT, "db mapping kind")
assert_eq_str(db_entry.val.obj["host"].s, "yaml.internal", "db host")
assert_eq_int(db_entry.val.obj["port"].i, 27017, "db port")

print("YAML_SOURCE_TEST: ALL PASS")

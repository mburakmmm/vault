# VAULT — Secret Provider Test Suite
# Tests: MemorySecretProvider, EnvSecretProvider, FileSecretProvider, Precedence Rank 7, Fail-Closed

from core.builder import ConfigBuilder
from core.snapshot import ConfigSnapshot
from core.errors import ConfigError, ERR_CONFIG_PROVIDER_UNAVAILABLE, ERR_CONFIG_PATH_OUTSIDE_ROOT, ERR_CONFIG_SOURCE_UNAVAILABLE, ERR_CONFIG_SIZE_LIMIT
from schema.fields import ConfigSchema
from providers.interface import SecretProvider, SecretFetchResult, ProviderHealth
from providers.memory import MemorySecretProvider
from providers.env import EnvSecretProvider
from providers.file import FileSecretProvider
from sources.memory import MemorySource
import nox.os
import nox.path

def test_memory_secret_provider() -> None:
    prov: MemorySecretProvider = MemorySecretProvider("test_mem_prov")
    prov.set_secret("JWT_KEY", "super_jwt_secret_val")

    # Success fetch
    res1: SecretFetchResult = prov.get("JWT_KEY")
    assert res1.found
    sec1: SecretValue | None = res1.val
    assert sec1 is not None
    if sec1 is not None:
        assert sec1.reveal() == "super_jwt_secret_val"
        assert sec1.to_string() == "[REDACTED]"

    # Absent key
    res2: SecretFetchResult = prov.get("NON_EXISTENT")
    assert not res2.found

    # Unhealthy provider
    prov.set_unhealthy("vault down for maintenance")
    res3: SecretFetchResult = prov.get("JWT_KEY")
    assert not res3.found
    assert res3.error_code == ERR_CONFIG_PROVIDER_UNAVAILABLE
    assert "maintenance" in res3.error_msg

    # Restore health and close
    prov.set_healthy()
    prov.close()
    res4: SecretFetchResult = prov.get("JWT_KEY")
    assert not res4.found
    print("PASS: test_memory_secret_provider")

def test_env_secret_provider() -> None:
    # Set a temporary test environment variable
    nox.os.set_var("VAULT_TEST_SECRET_ENV_VAR", "top_secret_token_123")

    allowed: list[str] = ["VAULT_TEST_SECRET_ENV_VAR", "LOGICAL_KEY"]
    mapping: dict[str, str] = {}
    mapping["LOGICAL_KEY"] = "VAULT_TEST_SECRET_ENV_VAR"

    prov: EnvSecretProvider = EnvSecretProvider(allowed, mapping)

    # 1. Direct allowed fetch
    res1: SecretFetchResult = prov.get("VAULT_TEST_SECRET_ENV_VAR")
    assert res1.found
    sec_env1: SecretValue | None = res1.val
    assert sec_env1 is not None
    if sec_env1 is not None:
        assert sec_env1.reveal() == "top_secret_token_123"

    # 2. Mapped allowed fetch
    res2: SecretFetchResult = prov.get("LOGICAL_KEY")
    assert res2.found
    sec_env2: SecretValue | None = res2.val
    assert sec_env2 is not None
    if sec_env2 is not None:
        assert sec_env2.reveal() == "top_secret_token_123"

    # 3. Disallowed key: must return not found without reading OS
    res3: SecretFetchResult = prov.get("PATH")
    assert not res3.found

    # 4. Allowed but absent env var
    res4: SecretFetchResult = prov.get("ABSENT_ALLOWED_VAR")
    assert not res4.found
    print("PASS: test_env_secret_provider")

def test_file_secret_provider() -> None:
    root_dir: str = nox.path.canonicalize("fixtures/secrets_dummy")
    prov: FileSecretProvider = FileSecretProvider(root_dir)
    prov.set_secret_file("DB_PASS", "fixtures/secrets_dummy/db_pass.txt")
    prov.set_secret_file("API_KEY", "fixtures/secrets_dummy/api_key.txt")

    # 1. Valid root-confined secret file read
    res1: SecretFetchResult = prov.get("DB_PASS")
    assert res1.found
    sec_f1: SecretValue | None = res1.val
    assert sec_f1 is not None
    if sec_f1 is not None:
        assert sec_f1.reveal() == "vault_super_secret_db_pass_123"
        assert sec_f1.to_string() == "[REDACTED]"

    res2: SecretFetchResult = prov.get("API_KEY")
    assert res2.found
    sec_f2: SecretValue | None = res2.val
    assert sec_f2 is not None
    if sec_f2 is not None:
        assert sec_f2.reveal() == "dummy_api_key_for_testing_abc"

    # 2. Path traversal attack: reject file outside allowed root (FILE-01)
    prov.set_secret_file("EVIL", "fixtures/secrets_dummy/../../AGENTS.md")
    res_evil: SecretFetchResult = prov.get("EVIL")
    assert not res_evil.found
    assert res_evil.error_code == ERR_CONFIG_PATH_OUTSIDE_ROOT

    # 3. Missing secret file
    prov.set_secret_file("MISSING", "fixtures/secrets_dummy/nonexistent.txt")
    res_missing: SecretFetchResult = prov.get("MISSING")
    assert not res_missing.found
    assert res_missing.error_code == ERR_CONFIG_SOURCE_UNAVAILABLE
    print("PASS: test_file_secret_provider")

def test_secret_provider_source_precedence() -> None:
    # Deterministic Precedence Rank:
    # Defaults (2) < Base File (3) < Profile File (4) < .env (5) < .env.<profile> (6) < Secret Provider (7) < Process Env (8) < Overrides (9)
    prov: MemorySecretProvider = MemorySecretProvider("mem_provider")
    prov.set_secret("SERVICE_KEY", "secret_from_provider_rank_7")
    prov.set_secret("DATABASE_PASSWORD", "db_pass_from_provider_rank_7")

    builder: ConfigBuilder = ConfigBuilder()

    # Rank 5: .env
    env_src: MemorySource = MemorySource(".env", 5, "base", False)
    env_src.set_string("SERVICE_KEY", "service_key_from_dotenv_rank_5")
    env_src.set_string("DATABASE_PASSWORD", "db_pass_from_dotenv_rank_5")
    builder.with_source(env_src)

    # Rank 6: .env.production
    profile_env: MemorySource = MemorySource(".env.production", 6, "production", False)
    profile_env.set_string("SERVICE_KEY", "service_key_from_profile_env_rank_6")
    profile_env.set_string("DATABASE_PASSWORD", "db_pass_from_profile_env_rank_6")
    builder.with_source(profile_env)

    # Rank 7: Secret Provider
    sec_keys: list[str] = ["SERVICE_KEY", "DATABASE_PASSWORD"]
    builder.with_secret_provider(prov, sec_keys, True)

    # Rank 9: Override DATABASE_PASSWORD
    builder.with_override("DATABASE_PASSWORD", "override_db_pass_rank_9")

    snap: ConfigSnapshot = builder.build()

    # SERVICE_KEY: Secret Provider (7) wins over .env.production (6) and .env (5)
    assert snap.get_secret("SERVICE_KEY") == "secret_from_provider_rank_7"
    assert snap.entries["SERVICE_KEY"].is_secret
    assert "source_kind=secret_provider" in snap.explain("SERVICE_KEY")
    assert "rank=7" in snap.explain("SERVICE_KEY")

    # DATABASE_PASSWORD: Override (9) wins over Secret Provider (7)
    assert snap.get_string("DATABASE_PASSWORD") == "override_db_pass_rank_9"

    # Redacted JSON verification: provider secret must be redacted
    json_repr: str = snap.redacted_json()
    assert "secret_from_provider_rank_7" not in json_repr
    assert "\"SERVICE_KEY\": \"[REDACTED]\"" in json_repr
    print("PASS: test_secret_provider_source_precedence")

def test_secret_provider_fail_closed() -> None:
    # When fail_closed=True and provider fails with error (not just missing), builder fails closed
    unhealthy_prov: MemorySecretProvider = MemorySecretProvider("down_prov")
    unhealthy_prov.set_unhealthy("kms unreachable")

    builder: ConfigBuilder = ConfigBuilder()
    req_keys: list[str] = ["KMS_KEY"]
    builder.with_secret_provider(unhealthy_prov, req_keys, True)

    caught: bool = False
    try:
        builder.build()
    except ConfigError as err:
        if err.code == ERR_CONFIG_PROVIDER_UNAVAILABLE:
            caught = True
    assert caught
    print("PASS: test_secret_provider_fail_closed")

# Run all test functions
test_memory_secret_provider()
test_env_secret_provider()
test_file_secret_provider()
test_secret_provider_source_precedence()
test_secret_provider_fail_closed()
print("ALL SECRET PROVIDER TESTS PASSED SUCCESSFULLY!")

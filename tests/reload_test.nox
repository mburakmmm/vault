# VAULT — Configuration Reload Manager Test Suite
# Tests: RELOAD-01, RELOAD-02, Validate-Before-Swap, Last-Known-Good Rollback, Reader Consistency

from core.builder import ConfigBuilder
from core.snapshot import ConfigSnapshot
from core.errors import ERR_CONFIG_TYPE_MISMATCH, ERR_CONFIG_INTERPOLATION_CYCLE
from schema.fields import ConfigSchema
from sources.memory import MemorySource
from reload.manager import ReloadManager, ReloadResult, PublishedConfig
import nox.time

def test_reload_02_successful_reload() -> None:
    # Set up schema and memory source
    schema: ConfigSchema = ConfigSchema()
    schema.add_string("APP_NAME", True, True, "ServiceA", False, True)
    schema.add_int("PORT", True, False, 0, True, 1024, True, 65535, False)

    mem_src: MemorySource = MemorySource("dynamic_mem", 5, "base", False)
    mem_src.set_string("APP_NAME", "VaultService")
    mem_src.set_string("PORT", "8080")

    builder: ConfigBuilder = ConfigBuilder()
    builder.with_schema(schema)
    builder.with_source(mem_src)

    manager: ReloadManager = ReloadManager(builder)

    # Initial state
    assert manager.get_version() == 1
    assert manager.snapshot().get_string("APP_NAME") == "VaultService"
    assert manager.snapshot().get_int("PORT") == 8080
    assert manager.snapshot().version() == "v1"

    # Retain a reference to the initial snapshot for reader consistency test
    snap_v1: ConfigSnapshot = manager.snapshot()

    # Modify source with valid updated settings
    mem_src.set_string("PORT", "9000")
    mem_src.set_string("APP_NAME", "VaultService-V2")

    # Perform reload
    res: ReloadResult = manager.reload()

    # Verify reload succeeded (RELOAD-02)
    assert res.success
    assert res.version == 2
    assert manager.get_version() == 2
    assert manager.snapshot().get_int("PORT") == 9000
    assert manager.snapshot().get_string("APP_NAME") == "VaultService-V2"
    assert manager.snapshot().version() == "v2"

    # Reader consistency: the earlier snapshot retained by callers continues reading v1 values
    assert snap_v1.get_int("PORT") == 8080
    assert snap_v1.get_string("APP_NAME") == "VaultService"
    assert snap_v1.version() == "v1"

    # RELOAD-04: Test unified PublishedConfig record
    pub: PublishedConfig = manager.get_published()
    assert pub.version == 2
    assert pub.snapshot.get_string("APP_NAME") == "VaultService-V2"
    assert pub.snapshot.get_int("PORT") == 9000

    print("PASS: test_reload_02_successful_reload")

def test_reload_01_invalid_config_rollback() -> None:
    # Schema requiring PORT as integer
    schema: ConfigSchema = ConfigSchema()
    schema.add_string("APP_NAME", True, True, "ServiceA", False, True)
    schema.add_int("PORT", True, False, 0, True, 1024, True, 65535, False)

    mem_src: MemorySource = MemorySource("dynamic_mem", 5, "base", False)
    mem_src.set_string("APP_NAME", "GoodApp")
    mem_src.set_string("PORT", "8080")

    builder: ConfigBuilder = ConfigBuilder()
    builder.with_schema(schema)
    builder.with_source(mem_src)

    manager: ReloadManager = ReloadManager(builder)
    assert manager.snapshot().get_int("PORT") == 8080
    assert manager.get_version() == 1

    # Modify source: Change APP_NAME (valid) but set PORT to invalid non-integer string (invalid)
    mem_src.set_string("APP_NAME", "CorruptCandidate")
    mem_src.set_string("PORT", "not_a_valid_number")

    # Attempt reload
    res: ReloadResult = manager.reload()

    # Verify reload failed and reported error (RELOAD-01)
    assert not res.success
    assert res.error_code == ERR_CONFIG_TYPE_MISMATCH
    assert res.version == 1

    # Verify LAST-KNOWN-GOOD snapshot was preserved wholly intact:
    # 1. Version did not advance
    assert manager.get_version() == 1
    # 2. PORT is still 8080
    assert manager.snapshot().get_int("PORT") == 8080
    # 3. APP_NAME was NOT partially updated to "CorruptCandidate"
    assert manager.snapshot().get_string("APP_NAME") == "GoodApp"
    assert manager.snapshot().version() == "v1"
    print("PASS: test_reload_01_invalid_config_rollback")

def test_reload_interpolation_cycle_rollback() -> None:
    # Test that introducing an interpolation cycle during reload is safely rejected and rolled back
    mem_src: MemorySource = MemorySource("interp_mem", 5, "base", False)
    mem_src.set_string("HOST", "db.internal")
    mem_src.set_string("DB_URL", "postgres://${HOST}:5432/db")

    builder: ConfigBuilder = ConfigBuilder()
    builder.with_source(mem_src)

    manager: ReloadManager = ReloadManager(builder)
    assert manager.snapshot().get_string("DB_URL") == "postgres://db.internal:5432/db"
    assert manager.get_version() == 1

    # Introduce a cyclic dependency: HOST references DB_URL
    mem_src.set_string("HOST", "prefix-${DB_URL}")

    res: ReloadResult = manager.reload()

    assert not res.success
    assert res.error_code == ERR_CONFIG_INTERPOLATION_CYCLE
    assert manager.get_version() == 1
    # Previous good snapshot intact
    assert manager.snapshot().get_string("DB_URL") == "postgres://db.internal:5432/db"
    print("PASS: test_reload_interpolation_cycle_rollback")

def test_consecutive_reloads_and_metrics() -> None:
    mem_src: MemorySource = MemorySource("metrics_mem", 5, "base", False)
    mem_src.set_string("STATUS", "init")

    builder: ConfigBuilder = ConfigBuilder()
    builder.with_source(mem_src)

    manager: ReloadManager = ReloadManager(builder)
    assert manager.version == 1
    assert manager.reload_count == 0
    assert manager.failed_reloads == 0

    # Reload 1: Valid
    mem_src.set_string("STATUS", "step1")
    res1: ReloadResult = manager.reload()
    assert res1.success
    assert manager.version == 2
    assert manager.snapshot().get_string("STATUS") == "step1"

    # Reload 2: Invalid (cycle)
    mem_src.set_string("STATUS", "${STATUS}")
    res2: ReloadResult = manager.reload()
    assert not res2.success
    assert manager.version == 2
    assert manager.snapshot().get_string("STATUS") == "step1"

    # Reload 3: Valid again
    mem_src.set_string("STATUS", "step3")
    res3: ReloadResult = manager.reload()
    assert res3.success
    assert manager.version == 3
    assert manager.snapshot().get_string("STATUS") == "step3"

    # Verify metrics
    assert manager.reload_count == 3
    assert manager.failed_reloads == 1
    print("PASS: test_consecutive_reloads_and_metrics")

def test_concurrent_reader_consistency_during_reload() -> None:
    # RELOAD-01: Readers holding references or querying snapshot during reload never see torn state
    schema: ConfigSchema = ConfigSchema()
    schema.add_string("APP_NAME", True, True, "DefaultApp", False, True)
    schema.add_int("PORT", True, False, 0, True, 1024, True, 65535, False)

    mem_src: MemorySource = MemorySource("concurrent_mem", 5, "base", False)
    mem_src.set_string("APP_NAME", "Version1App")
    mem_src.set_string("PORT", "8081")

    builder: ConfigBuilder = ConfigBuilder()
    builder.with_schema(schema)
    builder.with_source(mem_src)

    mgr: ReloadManager = ReloadManager(builder)

    # Reader 1 acquires initial snapshot
    snap_v1: ConfigSnapshot = mgr.snapshot()
    assert snap_v1.get_string("APP_NAME") == "Version1App"
    assert snap_v1.get_int("PORT") == 8081

    # Writer performs invalid reload (violates min port constraint)
    mem_src.set_string("PORT", "80") # Below min 1024
    res_fail: ReloadResult = mgr.reload()
    assert not res_fail.success
    # Manager retains last known good
    assert mgr.snapshot().get_int("PORT") == 8081
    # Reader 1's reference is completely unaltered
    assert snap_v1.get_int("PORT") == 8081

    # Writer performs valid update to Version 2
    mem_src.set_string("APP_NAME", "Version2App")
    mem_src.set_string("PORT", "9092")
    res_v2: ReloadResult = mgr.reload()
    assert res_v2.success
    assert mgr.get_version() == 2

    # Reader 2 acquires new snapshot
    snap_v2: ConfigSnapshot = mgr.snapshot()
    assert snap_v2.get_string("APP_NAME") == "Version2App"
    assert snap_v2.get_int("PORT") == 9092

    # Reader 1 holding old reference still sees consistent Version 1 data (zero torn reads!)
    assert snap_v1.get_string("APP_NAME") == "Version1App"
    assert snap_v1.get_int("PORT") == 8081

    print("PASS: test_concurrent_reader_consistency_during_reload")

def test_reload_reentrancy_guard() -> None:
    # RELOAD-02, RELOAD-03: Atomic CAS guard rejects simultaneous reentrant reload attempts
    mem_src: MemorySource = MemorySource("reentrant_mem", 5, "base", False)
    mem_src.set_string("KEY", "val")
    builder: ConfigBuilder = ConfigBuilder()
    builder.with_source(mem_src)
    mgr: ReloadManager = ReloadManager(builder)

    mgr.set_reloading_for_test(True) # Simulate concurrent reload in progress
    res: ReloadResult = mgr.reload()
    assert not res.success
    assert res.error_code == "CONFIG_RELOAD_IN_PROGRESS"
    mgr.set_reloading_for_test(False)
    print("PASS: test_reload_reentrancy_guard")

# Module-level fixtures for true concurrent multi-task stress test (RELOAD-02, RELOAD-03)
schema_stress: ConfigSchema = ConfigSchema()
schema_stress.add_string("APP_NAME", True, True, "DefaultApp", False, True)
schema_stress.add_int("PORT", True, False, 0, True, 1024, True, 65535, False)

mem_stress: MemorySource = MemorySource("stress_mem", 5, "base", False)
mem_stress.set_string("APP_NAME", "Version1App")
mem_stress.set_string("PORT", "8081")

b_stress: ConfigBuilder = ConfigBuilder()
b_stress.with_schema(schema_stress)
b_stress.with_source(mem_stress)

mgr_stress: ReloadManager = ReloadManager(b_stress)

async def _noop_step() -> None:
    pass

async def concurrent_reader_task(task_id: int) -> int:
    valid_reads: int = 0
    i: int = 0
    while i < 150:
        pub: PublishedConfig = mgr_stress.get_published()
        snap: ConfigSnapshot = pub.snapshot
        v: int = pub.version
        port: int = snap.get_int("PORT")
        name: str = snap.get_string("APP_NAME")
        # Invariant: Must always be either (8081, "Version1App", v=1) OR (9092, "Version2App", v=2)
        # Snapshot and published version must be in 100% atomic lockstep!
        if v == 1 and port == 8081 and name == "Version1App":
            valid_reads = valid_reads + 1
        elif v == 2 and port == 9092 and name == "Version2App":
            valid_reads = valid_reads + 1

        # RELOAD-04: Genuine cooperative fiber yield to force task context switches on single-threaded QBE & multi-threaded LLVM
        t_y: Task[None] = spawn _noop_step()
        await t_y
        i = i + 1
    return valid_reads

async def concurrent_writer_task(step: int) -> bool:
    # Yield to let readers start loop
    t_w_y: Task[None] = spawn _noop_step()
    await t_w_y
    mem_stress.set_string("APP_NAME", "Version2App")
    mem_stress.set_string("PORT", "9092")
    res: ReloadResult = mgr_stress.reload()
    return res.success

# Run all test functions
test_reload_02_successful_reload()
test_reload_01_invalid_config_rollback()
test_reload_interpolation_cycle_rollback()
test_consecutive_reloads_and_metrics()
test_concurrent_reader_consistency_during_reload()
test_reload_reentrancy_guard()

# Spawn 3 concurrent reader tasks and 1 concurrent writer task
t_r1: Task[int] = spawn concurrent_reader_task(1)
t_r2: Task[int] = spawn concurrent_reader_task(2)
t_w: Task[bool] = spawn concurrent_writer_task(1)
t_r3: Task[int] = spawn concurrent_reader_task(3)

r1_valid: int = await t_r1
r2_valid: int = await t_r2
writer_ok: bool = await t_w
r3_valid: int = await t_r3

assert writer_ok, "concurrent writer reload must succeed"
assert r1_valid == 150, "Reader 1 observed torn state: " + str(r1_valid) + "/150"
assert r2_valid == 150, "Reader 2 observed torn state: " + str(r2_valid) + "/150"
assert r3_valid == 150, "Reader 3 observed torn state: " + str(r3_valid) + "/150"
assert mgr_stress.get_version() == 2
print("PASS: test_true_concurrent_readers_and_writer_stress")

print("ALL RELOAD TESTS PASSED SUCCESSFULLY!")

# VAULT Example: Secret Redaction and Authorized Access
from vault import ConfigBuilder, ConfigSchema, ConfigSnapshot
from sources.memory import MemorySource
from providers.memory import MemorySecretProvider

prov: MemorySecretProvider = MemorySecretProvider("vault_agent_provider")
prov.set_secret("JWT_SIGNING_KEY", "prod_super_jwt_secret_999888")

mem: MemorySource = MemorySource("app_settings", 5, "base", False)
mem.set_string("JWT_SIGNING_KEY", "default_dummy")

schema: ConfigSchema = ConfigSchema()
schema.add_string("JWT_SIGNING_KEY", True, False, "", True, True) # marked secret!

builder: ConfigBuilder = ConfigBuilder()
builder.with_schema(schema)
builder.with_source(mem)
secret_keys: list[str] = ["JWT_SIGNING_KEY"]
builder.with_secret_provider(prov, secret_keys, True)

snapshot: ConfigSnapshot = builder.build()

# 1. Safe JSON export (masked)
print("Redacted JSON Export:")
print(snapshot.redacted_json())

# 2. Safe provenance inspection (no secret disclosure)
print("Provenance:")
print(snapshot.explain("JWT_SIGNING_KEY"))

# 3. Authorized access for signing operations
secret_token: str = snapshot.get_secret("JWT_SIGNING_KEY")
print("Secret key retrieved safely for internal cryptography.")

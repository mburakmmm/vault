# VAULT — Multi-Worker Configuration Architecture Example (NOX v2.1.186)
# Demonstrates real OS worker threads (nox.thread.start) receiving lock-free
# configuration broadcasts via SharedConfigBus (nox.atomic.AtomicRef) while each
# worker maintains its own isolated ReloadManager & validated ConfigSnapshot.

from vault import ConfigBuilder, ConfigSchema, ConfigSnapshot, ReloadManager, MemorySource, SharedConfigBus, attach_config_bus
import nox.thread
import nox.json
import nox.time
import nox.strings

async def worker_loop(worker_spec: str) -> str:
    parts: list[str] = nox.strings.split(worker_spec, ":")
    worker_id: int = int(parts[0])
    bus_handle: int = int(parts[1])
    bus: SharedConfigBus = attach_config_bus(bus_handle)

    schema: ConfigSchema = ConfigSchema()
    schema.add_string("SERVICE_NAME", True, True, "WorkerService", False, True)
    schema.add_string("DATABASE_URL", True, False, "", False, True)
    schema.add_int("PORT", True, False, 8080, True, 1024, True, 65535, False)

    src: MemorySource = MemorySource("worker_" + str(worker_id), 5, "base", False)
    src.set_string("PORT", str(8000 + worker_id))

    # Wait until coordinator publishes an updated manifest (version >= 1)
    attempts: int = 0
    while bus.version() < 1 and attempts < 200:
        nox.time.sleep_ms(5)
        attempts = attempts + 1

    payload: str = bus.read_payload()
    last_ver: int = bus.version()
    jv: JsonValue = nox.json.parse(payload)
    src.set_string("DATABASE_URL", nox.json.get(jv, "DATABASE_URL").s)

    b: ConfigBuilder = ConfigBuilder()
    b.with_schema(schema)
    b.with_source(src)
    mgr: ReloadManager = ReloadManager(b)
    snap: ConfigSnapshot = mgr.snapshot()
    return "worker=" + str(worker_id) + ", bus_ver=" + str(last_ver) + ", db=" + snap.get_string("DATABASE_URL") + ", port=" + str(snap.get_int("PORT"))

async def run_coordinated_workers() -> None:
    print("=== VAULT Real Multi-Worker SharedConfigBus Example ===")
    bus: SharedConfigBus = SharedConfigBus("{\"DATABASE_URL\": \"postgres://primary:5432/app\"}")

    # Launch two isolated OS worker threads (QBE) / M:N tasks (LLVM) passing portable str specs
    t1: ThreadHandle[str] = nox.thread.start(worker_loop, "1:" + str(bus.handle()))
    t2: ThreadHandle[str] = nox.thread.start(worker_loop, "2:" + str(bus.handle()))

    # Coordinator broadcasts failover configuration update
    nox.time.sleep_ms(10)
    new_ver: int = bus.publish_payload("{\"DATABASE_URL\": \"postgres://failover:5432/app\"}")
    print("Coordinator broadcast published bus version: " + str(new_ver))

    r1: str = await t1.join()
    r2: str = await t2.join()
    print(r1)
    print(r2)
    bus.close()

await spawn run_coordinated_workers()

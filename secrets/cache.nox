# VAULT — TTL-Backed In-Memory Secret Cache
# Module: secrets.cache

class CachedSecret:
    val: str
    expires_at: int

    def __init__(self: CachedSecret, val: str, expires_at: int) -> None:
        self.val = val
        self.expires_at = expires_at

class SecretCache:
    entries: dict[str, CachedSecret]

    def __init__(self: SecretCache) -> None:
        self.entries = {}

    def set(self: SecretCache, key: str, val: str, ttl_seconds: int, now_seconds: int) -> None:
        expires_at: int = now_seconds + ttl_seconds
        self.entries[key] = CachedSecret(val, expires_at)

    def get(self: SecretCache, key: str, now_seconds: int) -> str | None:
        if key not in self.entries:
            return None
        cs: CachedSecret = self.entries[key]
        if now_seconds >= cs.expires_at:
            # Expired: evict from cache
            self.evict(key)
            return None
        return cs.val

    def has(self: SecretCache, key: str, now_seconds: int) -> bool:
        res: str | None = self.get(key, now_seconds)
        return res is not None

    def evict(self: SecretCache, key: str) -> None:
        if key in self.entries:
            # We construct a new dictionary without 'key'
            new_entries: dict[str, CachedSecret] = {}
            k_list: list[str] = self.entries.keys()
            idx: int = 0
            while idx < len(k_list):
                curr_k: str = k_list[idx]
                if curr_k != key:
                    new_entries[curr_k] = self.entries[curr_k]
                idx = idx + 1
            self.entries = new_entries

    def clear(self: SecretCache) -> None:
        self.entries = {}

    def active_count(self: SecretCache, now_seconds: int) -> int:
        count: int = 0
        k_list: list[str] = self.entries.keys()
        idx: int = 0
        while idx < len(k_list):
            curr_k: str = k_list[idx]
            cs: CachedSecret = self.entries[curr_k]
            if now_seconds < cs.expires_at:
                count = count + 1
            idx = idx + 1
        return count

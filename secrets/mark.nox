# VAULT — Secret Classification and Wrapper Model
# Module: secrets.mark

REDACTED_LABEL: str = "[REDACTED]"

class SecretValue:
    raw_value: str
    key: str

    def __init__(self: SecretValue, raw_value: str, key: str) -> None:
        self.raw_value = raw_value
        self.key = key

    def to_string(self: SecretValue) -> str:
        # Default textual representation must NEVER leak the secret content
        return REDACTED_LABEL

    def reveal(self: SecretValue) -> str:
        # Intentional and authorized retrieval of underlying value
        return self.raw_value

    def length(self: SecretValue) -> int:
        return len(self.raw_value)

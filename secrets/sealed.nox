# VAULT — Authenticated AEAD Secret Envelope & Encrypted Bundle Support
# Module: secrets.sealed
# Opt-in authenticated encryption built atop NOX v2.2 nox.crypto AEAD primitives
# (XChaCha20-Poly1305 default, ChaCha20-Poly1305, AES-256-GCM, AES-128-GCM).

from core.errors import ConfigError, ERR_CONFIG_SECRET_SOURCE_DENIED, ERR_CONFIG_PARSE_ERROR
from secrets.mark import SecretValue
from nox.crypto import CryptoError
from nox.json import JsonError
import nox.crypto
import nox.json

DEFAULT_AEAD_ALGORITHM: str = "xchacha20-poly1305"

def _nonce_bytes_for_algorithm(algorithm: str) -> int:
    if algorithm == "xchacha20-poly1305":
        return 24
    if algorithm == "chacha20-poly1305" or algorithm == "aes-256-gcm" or algorithm == "aes-128-gcm":
        return 12
    raise ConfigError(ERR_CONFIG_PARSE_ERROR, algorithm, "unsupported AEAD algorithm: " + algorithm)

def _aad_for_secret(key_name: str, profile: str) -> str:
    return "vault:aead:v1:" + profile + ":" + key_name

def _aad_for_bundle(format_name: str, profile: str) -> str:
    return "vault:bundle:v1:" + profile + ":" + format_name

class SealedEnvelope:
    version: str
    algorithm: str
    format_name: str
    profile: str
    nonce_hex: str
    ciphertext_hex: str

    def __init__(self: SealedEnvelope, version: str, algorithm: str, format_name: str, profile: str, nonce_hex: str, ciphertext_hex: str) -> None:
        self.version = version
        self.algorithm = algorithm
        self.format_name = format_name
        self.profile = profile
        self.nonce_hex = nonce_hex
        self.ciphertext_hex = ciphertext_hex

    def to_string(self: SealedEnvelope) -> str:
        return "SealedEnvelope(version=" + self.version + ", alg=" + self.algorithm + ", profile=" + self.profile + ", ciphertext=[REDACTED])"

    def to_json(self: SealedEnvelope) -> str:
        return (
            "{\"vault_sealed_v1\":true"
            + ",\"version\":" + nox.json.dump_string(self.version)
            + ",\"algorithm\":" + nox.json.dump_string(self.algorithm)
            + ",\"format\":" + nox.json.dump_string(self.format_name)
            + ",\"profile\":" + nox.json.dump_string(self.profile)
            + ",\"nonce_hex\":" + nox.json.dump_string(self.nonce_hex)
            + ",\"ciphertext_hex\":" + nox.json.dump_string(self.ciphertext_hex)
            + "}"
        )

def sealed_envelope_from_json(raw_json: str, source_id: str = "sealed_envelope") -> SealedEnvelope:
    try:
        jv: JsonValue = nox.json.parse(raw_json)
    except JsonError:
        raise ConfigError(ERR_CONFIG_PARSE_ERROR, source_id, "invalid sealed envelope JSON")

    if not nox.json.is_object(jv):
        raise ConfigError(ERR_CONFIG_PARSE_ERROR, source_id, "sealed envelope JSON must be an object")

    try:
        marker: JsonValue = nox.json.get(jv, "vault_sealed_v1")
        if not nox.json.is_bool(marker) or not nox.json.as_bool(marker):
            raise ConfigError(ERR_CONFIG_PARSE_ERROR, source_id, "missing vault_sealed_v1 marker")

        ver: str = nox.json.as_string(nox.json.get(jv, "version"))
        alg: str = nox.json.as_string(nox.json.get(jv, "algorithm"))
        fmt: str = nox.json.as_string(nox.json.get(jv, "format"))
        prof: str = nox.json.as_string(nox.json.get(jv, "profile"))
        nonce_hex: str = nox.json.as_string(nox.json.get(jv, "nonce_hex"))
        ct_hex: str = nox.json.as_string(nox.json.get(jv, "ciphertext_hex"))
        return SealedEnvelope(ver, alg, fmt, prof, nonce_hex, ct_hex)
    except ConfigError as err:
        raise err
    except JsonError:
        raise ConfigError(ERR_CONFIG_PARSE_ERROR, source_id, "malformed or incomplete sealed envelope fields")

def seal_secret(key_hex: str, key_name: str, plaintext: str, profile: str = "base", algorithm: str = "xchacha20-poly1305") -> SealedEnvelope:
    nonce_bytes: int = _nonce_bytes_for_algorithm(algorithm)
    aad: str = _aad_for_secret(key_name, profile)
    try:
        nonce_hex: str = nox.crypto.secure_random_hex(nonce_bytes)
        sealed_hex: str = nox.crypto.aead_seal(key_hex, nonce_hex, plaintext, aad, algorithm)
        return SealedEnvelope("v1", algorithm, "secret", profile, nonce_hex, sealed_hex)
    except CryptoError:
        raise ConfigError(ERR_CONFIG_SECRET_SOURCE_DENIED, key_name, "AEAD encryption failed (check key length or hex encoding)")

def open_secret(key_hex: str, key_name: str, env: SealedEnvelope, profile: str = "base") -> SecretValue:
    if env.profile != profile:
        raise ConfigError(ERR_CONFIG_SECRET_SOURCE_DENIED, key_name, "sealed secret profile mismatch (fail-closed)")
    aad: str = _aad_for_secret(key_name, profile)
    try:
        plain: str = nox.crypto.aead_open(key_hex, env.nonce_hex, env.ciphertext_hex, aad, env.algorithm)
        return SecretValue(plain, key_name)
    except CryptoError:
        raise ConfigError(ERR_CONFIG_SECRET_SOURCE_DENIED, key_name, "AEAD authentication or decryption failed (fail-closed)")

def seal_config_bundle(key_hex: str, payload: str, format_name: str, profile: str = "base", algorithm: str = "xchacha20-poly1305") -> str:
    nonce_bytes: int = _nonce_bytes_for_algorithm(algorithm)
    aad: str = _aad_for_bundle(format_name, profile)
    try:
        nonce_hex: str = nox.crypto.secure_random_hex(nonce_bytes)
        sealed_hex: str = nox.crypto.aead_seal(key_hex, nonce_hex, payload, aad, algorithm)
        env: SealedEnvelope = SealedEnvelope("v1", algorithm, format_name, profile, nonce_hex, sealed_hex)
        return env.to_json()
    except CryptoError:
        raise ConfigError(ERR_CONFIG_SECRET_SOURCE_DENIED, format_name, "AEAD bundle encryption failed")

def open_config_bundle(key_hex: str, env: SealedEnvelope, expected_profile: str = "base", source_id: str = "sealed_bundle") -> str:
    if env.profile != expected_profile:
        raise ConfigError(ERR_CONFIG_SECRET_SOURCE_DENIED, source_id, "sealed bundle profile mismatch (fail-closed)")
    aad: str = _aad_for_bundle(env.format_name, expected_profile)
    try:
        return nox.crypto.aead_open(key_hex, env.nonce_hex, env.ciphertext_hex, aad, env.algorithm)
    except CryptoError:
        raise ConfigError(ERR_CONFIG_SECRET_SOURCE_DENIED, source_id, "sealed bundle decryption or authentication failed (fail-closed)")

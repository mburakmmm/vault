# VAULT — Structured Redaction and Safe JSON Serialization
# Module: secrets.redact

from core.types import ConfigEntry, ConfigValue, VAL_NULL, VAL_MISSING, VAL_STRING, VAL_INTEGER, VAL_FLOAT, VAL_BOOLEAN, VAL_ARRAY, VAL_OBJECT, PRESENCE_NULL
from secrets.mark import REDACTED_LABEL
import nox.strings
import nox.json

def escape_json_str(s: str) -> str:
    dumped: str = nox.json.dump_string(s)
    if len(dumped) >= 2:
        return dumped[1:len(dumped) - 1]
    return dumped

def _redact_one_sentinel(text: str, sentinel: str) -> str:
    if len(sentinel) == 0:
        return text
    out: str = ""
    remaining: str = text
    active: bool = True
    while active:
        pos: int = nox.strings.index_of(remaining, sentinel)
        if pos >= 0:
            out = out + remaining[0:pos] + REDACTED_LABEL
            # Advance strictly beyond the matched sentinel without re-scanning the newly inserted label
            remaining = remaining[pos + len(sentinel):len(remaining)]
        else:
            out = out + remaining
            active = False
    return out

def redact_string(text: str, sentinels: list[str]) -> str:
    result: str = text
    s_idx: int = 0
    while s_idx < len(sentinels):
        sentinel: str = sentinels[s_idx]
        if len(sentinel) > 0:
            result = _redact_one_sentinel(result, sentinel)
        s_idx = s_idx + 1
    return result

def _sort_keys(keys: list[str]) -> list[str]:
    sorted_k: list[str] = []
    idx: int = 0
    while idx < len(keys):
        sorted_k.append(keys[idx])
        idx = idx + 1

    n: int = len(sorted_k)
    i: int = 0
    while i < n:
        j: int = 0
        while j < n - i - 1:
            if sorted_k[j] > sorted_k[j + 1]:
                temp: str = sorted_k[j]
                sorted_k[j] = sorted_k[j + 1]
                sorted_k[j + 1] = temp
            j = j + 1
        i = i + 1

    return sorted_k

def _config_value_to_json(v: ConfigValue, is_secret: bool) -> str:
    if is_secret:
        return "\"" + REDACTED_LABEL + "\""
    if v.kind == VAL_NULL or v.kind == VAL_MISSING:
        return "null"
    if v.kind == VAL_STRING:
        return nox.json.dump_string(v.s)
    if v.kind == VAL_INTEGER:
        return str(v.i)
    if v.kind == VAL_FLOAT:
        return str(v.f)
    if v.kind == VAL_BOOLEAN:
        return "true" if v.b else "false"
    if v.kind == VAL_ARRAY:
        arr_str: str = "["
        a_idx: int = 0
        while a_idx < len(v.arr):
            if a_idx > 0:
                arr_str = arr_str + ", "
            arr_str = arr_str + _config_value_to_json(v.arr[a_idx], False)
            a_idx = a_idx + 1
        arr_str = arr_str + "]"
        return arr_str
    if v.kind == VAL_OBJECT:
        obj_str: str = "{"
        obj_keys: list[str] = _sort_keys(v.obj.keys())
        o_idx: int = 0
        while o_idx < len(obj_keys):
            if o_idx > 0:
                obj_str = obj_str + ", "
            ok: str = obj_keys[o_idx]
            obj_str = obj_str + nox.json.dump_string(ok) + ": " + _config_value_to_json(v.obj[ok], False)
            o_idx = o_idx + 1
        obj_str = obj_str + "}"
        return obj_str
    return "null"

def to_redacted_json(entries: dict[str, ConfigEntry]) -> str:
    raw_keys: list[str] = entries.keys()
    sorted_keys: list[str] = _sort_keys(raw_keys)

    json_out: str = "{\n"
    idx: int = 0
    while idx < len(sorted_keys):
        k: str = sorted_keys[idx]
        e: ConfigEntry = entries[k]

        val_json: str = ""
        if e.is_secret:
            val_json = "\"" + REDACTED_LABEL + "\""
        elif e.presence == PRESENCE_NULL:
            val_json = "null"
        else:
            val_json = _config_value_to_json(e.val, False)

        comma: str = "," if idx < len(sorted_keys) - 1 else ""
        json_out = json_out + "  " + nox.json.dump_string(k) + ": " + val_json + comma + "\n"
        idx = idx + 1

    json_out = json_out + "}"
    return json_out

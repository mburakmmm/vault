# VAULT — Intentional Secret Retrieval
# Module: secrets.reveal

from core.types import ConfigEntry, ConfigValue, VAL_STRING, VAL_INTEGER, VAL_FLOAT, VAL_BOOLEAN, PRESENCE_NULL, PRESENCE_MISSING
from core.errors import ConfigError, ERR_CONFIG_MISSING, ERR_CONFIG_NULL_NOT_ALLOWED, ERR_CONFIG_TYPE_MISMATCH
from secrets.mark import SecretValue

def reveal_secret_entry(entry: ConfigEntry) -> str:
    if entry.presence == PRESENCE_NULL:
        raise ConfigError(ERR_CONFIG_NULL_NOT_ALLOWED, entry.key, "secret value is null")
    if entry.presence == PRESENCE_MISSING:
        raise ConfigError(ERR_CONFIG_MISSING, entry.key, "secret value is missing")

    v: ConfigValue = entry.val
    if v.kind == VAL_STRING:
        return v.s
    if v.kind == VAL_INTEGER:
        return str(v.i)
    if v.kind == VAL_BOOLEAN:
        return "true" if v.b else "false"
    if v.kind == VAL_FLOAT:
        return str(v.f)

    raise ConfigError(ERR_CONFIG_TYPE_MISMATCH, entry.key, "secret value cannot be represented as string")

def create_secret_value(entry: ConfigEntry) -> SecretValue:
    raw: str = reveal_secret_entry(entry)
    return SecretValue(raw, entry.key)

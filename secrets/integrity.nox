# VAULT — Configuration Integrity & Cryptographic Attestation Helpers
# Module: secrets.integrity
# Powered by NOX v2.1.70 (blake3, sha3_256) and v2.1.154 (nox.ed25519).

from core.errors import ConfigError, ERR_CONFIG_SIGNATURE_INVALID
import nox.crypto
import nox.ed25519
import nox.strings

def compute_blake3_hex(content: str) -> str:
    return nox.crypto.blake3(content)

def compute_sha3_256_hex(content: str) -> str:
    return nox.crypto.sha3_256(content)

def verify_payload_blake3(payload: str, expected_hex: str) -> bool:
    if len(expected_hex) != 64:
        return False
    actual: str = nox.crypto.blake3(payload)
    norm_expected: str = nox.strings.lower(expected_hex)
    return nox.crypto.constant_time_eq(actual, norm_expected)

def verify_payload_ed25519(payload: str, pub_key_hex: str, signature_hex: str) -> bool:
    if len(pub_key_hex) != 64 or len(signature_hex) != 128:
        return False
    return nox.ed25519.verify(pub_key_hex, payload, signature_hex)

def require_valid_ed25519(payload: str, pub_key_hex: str, signature_hex: str, context_key: str) -> None:
    if not verify_payload_ed25519(payload, pub_key_hex, signature_hex):
        raise ConfigError(
            ERR_CONFIG_SIGNATURE_INVALID,
            context_key,
            "ed25519 cryptographic signature verification failed (rejected fail-closed before parsing)"
        )

def publisher_key_fingerprint(pub_key_hex: str) -> str:
    return nox.ed25519.fingerprint(pub_key_hex)

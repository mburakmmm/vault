# VAULT — Validated Configuration Reload Manager
# Module: reload.manager

from core.builder import ConfigBuilder
from core.snapshot import ConfigSnapshot
from core.errors import ConfigError
from nox.atomic import new_bool, AtomicBool, new_int, AtomicInt
import nox.time

class PublishedConfig:
    _version: int
    _snapshot: ConfigSnapshot
    _published_at_ms: int
    _reload_count: int

    def __init__(self: PublishedConfig, version: int, snapshot: ConfigSnapshot, published_at_ms: int, reload_count: int) -> None:
        self._version = version
        self._snapshot = snapshot
        if published_at_ms > 0:
            self._published_at_ms = published_at_ms
        else:
            self._published_at_ms = nox.time.now_ms()
        self._reload_count = reload_count

    @property
    def version(self: PublishedConfig) -> int:
        return self._version

    @property
    def snapshot(self: PublishedConfig) -> ConfigSnapshot:
        return self._snapshot

    @property
    def published_at_ms(self: PublishedConfig) -> int:
        return self._published_at_ms

    @property
    def reload_count(self: PublishedConfig) -> int:
        return self._reload_count

class ReloadResult:
    success: bool
    version: int
    error_code: str
    error_message: str
    snapshot: ConfigSnapshot

    def __init__(self: ReloadResult, success: bool, version: int, error_code: str, error_message: str, snapshot: ConfigSnapshot) -> None:
        self.success = success
        self.version = version
        self.error_code = error_code
        self.error_message = error_message
        self.snapshot = snapshot

class ReloadManager:
    builder: ConfigBuilder
    _published: PublishedConfig
    reload_count: int
    failed_reloads: int
    _atomic_reloading: AtomicBool
    _atomic_version: AtomicInt
    _atomic_seq: AtomicInt

    def __init__(self: ReloadManager, builder: ConfigBuilder) -> None:
        self.builder = builder
        self.reload_count = 0
        self.failed_reloads = 0
        self._atomic_reloading = new_bool(False)
        self._atomic_version = new_int(1)
        self._atomic_seq = new_int(0)
        self.builder.builder_version = "v1"
        initial_snap: ConfigSnapshot = self.builder.build()
        now_ts: int = nox.time.now_ms()
        self._published = PublishedConfig(1, initial_snap, now_ts, 0)

    @property
    def is_reloading(self: ReloadManager) -> bool:
        return self._atomic_reloading.load()

    def set_reloading_for_test(self: ReloadManager, reloading: bool) -> None:
        self._atomic_reloading.store(reloading)

    def get_published(self: ReloadManager) -> PublishedConfig:
        # RELOAD-10: Seqlock read barrier protocol ensuring consistent, untorn publication
        retries: int = 0
        while retries < 100:
            seq1: int = self._atomic_seq.load()
            if (seq1 & 1) != 0:
                # Write transaction in progress; spin/retry
                retries = retries + 1
                continue
            pub: PublishedConfig = self._published
            seq2: int = self._atomic_seq.load()
            if seq1 == seq2:
                return pub
            retries = retries + 1
        return self._published

    def snapshot(self: ReloadManager) -> ConfigSnapshot:
        return self.get_published().snapshot

    @property
    def current_snapshot(self: ReloadManager) -> ConfigSnapshot:
        return self.get_published().snapshot

    @property
    def version(self: ReloadManager) -> int:
        return self.get_published().version

    def get_version(self: ReloadManager) -> int:
        return self.get_published().version

    def get_atomic_version(self: ReloadManager) -> int:
        # RELOAD-09: Hardware memory-barrier synchronized atomic integer read
        return self._atomic_version.load()

    def get_atomic_seq(self: ReloadManager) -> int:
        # RELOAD-10: Hardware seqlock sequence counter
        return self._atomic_seq.load()

    def reload(self: ReloadManager) -> ReloadResult:
        # RELOAD-06: Atomic CAS Lock MUST be acquired BEFORE reading current_pub
        # Guarantees strictly one thread/worker enters the critical section,
        # and reads the true latest published version rather than a stale pre-lock reference!
        if not self._atomic_reloading.compare_and_swap(False, True):
            stale_pub: PublishedConfig = self._published
            return ReloadResult(False, stale_pub.version, "CONFIG_RELOAD_IN_PROGRESS", "another reload is currently in progress", stale_pub.snapshot)

        current_pub: PublishedConfig = self._published
        self.reload_count = self.reload_count + 1
        next_version_num: int = current_pub.version + 1
        self.builder.builder_version = "v" + str(next_version_num)

        try:
            # 1. Build complete candidate snapshot off to the side
            candidate: ConfigSnapshot = self.builder.build()

            # 2. RELOAD-05, RELOAD-09 & RELOAD-10: Seqlock publication barrier protocol
            now_reload: int = nox.time.now_ms()
            new_pub: PublishedConfig = PublishedConfig(next_version_num, candidate, now_reload, self.reload_count)

            # Step 1: Open seqlock write transaction (sequence becomes odd)
            self._atomic_seq.increment()
            # Step 2: Update hardware atomic version counter
            self._atomic_version.store(next_version_num)
            # Step 3: Publish new snapshot pointer atomically
            self._published = new_pub
            # Step 4: Close seqlock write transaction (sequence becomes even)
            self._atomic_seq.increment()
            # Step 5: Release CAS reload lock
            self._atomic_reloading.store(False)
            return ReloadResult(True, new_pub.version, "", "", new_pub.snapshot)

        except ConfigError as err:
            # 3. Validation or load failed: retain entire previous snapshot wholly intact
            self.failed_reloads = self.failed_reloads + 1
            self.builder.builder_version = "v" + str(current_pub.version)
            self._atomic_reloading.store(False)
            return ReloadResult(False, current_pub.version, err.code, err.message, current_pub.snapshot)

        except Exception:
            self.failed_reloads = self.failed_reloads + 1
            self.builder.builder_version = "v" + str(current_pub.version)
            self._atomic_reloading.store(False)
            return ReloadResult(False, current_pub.version, "CONFIG_RELOAD_ERROR", "unexpected error during reload", current_pub.snapshot)
